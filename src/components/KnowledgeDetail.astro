---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';

const { entry, backHref, backLabel } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter(heading => heading.depth >= 1 && heading.depth <= 3);
---

<main class="app-shell blog-page-shell">
  <a href={backHref} class="blog-back">← {backLabel}</a>
  <div class="blog-detail-layout">
    {tocHeadings.length > 0 && (
      <aside class="blog-toc-column" aria-label="文章目录">
        <details class="blog-toc" open>
          <summary>本文目录</summary>
          <nav>
            {tocHeadings.map(heading => <a href={`#${heading.slug}`} class={`blog-toc-link depth-${heading.depth}`} data-heading-id={heading.slug}>{heading.text}</a>)}
          </nav>
        </details>
      </aside>
    )}

    <article class="blog-article">
      <header class="blog-article-header">
        <h1 class="blog-article-title">{entry.data.title}</h1>
        <p class="blog-article-date">发布于 {entry.data.date}{entry.data.updated && entry.data.updated !== entry.data.date && ` · 更新于 ${entry.data.updated}`}</p>
        <div class="blog-article-tags">
          <span class="blog-tag category-tag category-knowledge">{entry.data.category}</span>
          {entry.data.subcategory && <span class="blog-tag">{entry.data.subcategory}</span>}
        </div>
      </header>
      <div class="blog-article-body"><Content /></div>
    </article>
  </div>
</main>

<script>
  const tocLinks = Array.from(document.querySelectorAll('.blog-toc-link'));
  const articleHeadings = Array.from(document.querySelectorAll('.blog-article-body h1[id], .blog-article-body h2[id], .blog-article-body h3[id]'));
  function updateActiveHeading() {
    let activeId = articleHeadings[0]?.id;
    for (const heading of articleHeadings) {
      if (heading.getBoundingClientRect().top <= 120) activeId = heading.id;
      else break;
    }
    tocLinks.forEach(link => link.classList.toggle('active', link.dataset.headingId === activeId));
  }
  const scrollContainer = document.querySelector('.main-area');
  if (tocLinks.length && articleHeadings.length) {
    updateActiveHeading();
    scrollContainer?.addEventListener('scroll', () => requestAnimationFrame(updateActiveHeading), { passive: true });
    window.addEventListener('hashchange', updateActiveHeading);
  }
  document.querySelectorAll('.tip-label').forEach(label => label.addEventListener('click', () => label.closest('li')?.classList.toggle('pinned')));
  const popoverTemplates = new Map(
    Array.from(document.querySelectorAll('[data-article-popover-content]'))
      .map(template => [template.dataset.articlePopoverContent, template]),
  );
  document.querySelectorAll('[data-article-popover-trigger]').forEach(trigger => {
    if (trigger.dataset.articlePopoverBound) return;
    trigger.dataset.articlePopoverBound = 'true';
    const template = popoverTemplates.get(trigger.dataset.articlePopoverTrigger);
    if (!template) return;

    const panel = document.createElement('div');
    panel.className = 'blog-article-body article-popover-panel';
    panel.id = `article-popover-${encodeURIComponent(trigger.dataset.articlePopoverTrigger)}`;
    panel.setAttribute('role', 'dialog');
    panel.setAttribute('aria-hidden', 'true');
    trigger.setAttribute('aria-controls', panel.id);
    const content = document.createElement('div');
    content.className = 'article-popover-content';
    content.innerHTML = template.innerHTML;
    panel.append(content);
    panel.dataset.popoverKind = content.querySelector('table') ? 'table' : 'note';

    const heading = document.createElement('div');
    heading.className = 'article-popover-heading';
    const title = document.createElement('span');
    title.className = 'article-popover-title';
    title.textContent = trigger.textContent.trim();
    heading.append(title);
    panel.prepend(heading);
    document.body.append(panel);

    let pinned = false;
    let hideTimer;
    const padding = 16;
    const gap = 10;
    const cancelHide = () => {
      if (hideTimer) window.clearTimeout(hideTimer);
    };
    const close = () => {
      pinned = false;
      panel.classList.remove('is-visible');
      panel.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
    };
    const scheduleHide = () => {
      cancelHide();
      hideTimer = window.setTimeout(() => {
        if (!pinned) close();
      }, 160);
    };
    const position = () => {
      if (!panel.classList.contains('is-visible')) return;
      const triggerRect = trigger.getBoundingClientRect();
      const panelRect = panel.getBoundingClientRect();
      const left = Math.min(
        Math.max(triggerRect.left, padding),
        window.innerWidth - panelRect.width - padding,
      );
      const topSpace = Math.max(0, triggerRect.top - padding - gap);
      const bottomSpace = Math.max(0, window.innerHeight - triggerRect.bottom - padding - gap);
      const fitsTop = panelRect.height <= topSpace;
      const fitsBottom = panelRect.height <= bottomSpace;
      const placement = fitsBottom || (!fitsTop && bottomSpace >= topSpace) ? 'bottom' : 'top';
      const availableSpace = placement === 'bottom' ? bottomSpace : topSpace;

      // A long footnote must scroll within the side with more room instead of
      // being clamped over the trigger when neither side fits at full height.
      const contentRect = content.getBoundingClientRect();
      const panelChrome = panelRect.height - contentRect.height;
      const defaultContentMaxHeight = Math.min(window.innerHeight * .7, 560);
      const availableContentHeight = Math.max(0, availableSpace - panelChrome);
      content.style.maxHeight = `${Math.min(defaultContentMaxHeight, availableContentHeight)}px`;

      const positionedPanelRect = panel.getBoundingClientRect();
      const preferredTop = placement === 'bottom'
        ? triggerRect.bottom + gap
        : triggerRect.top - positionedPanelRect.height - gap;
      const top = Math.max(
        padding,
        Math.min(preferredTop, window.innerHeight - padding - positionedPanelRect.height),
      );
      const arrowLeft = Math.min(
        Math.max(triggerRect.left + triggerRect.width / 2 - left, 22),
        positionedPanelRect.width - 22,
      );
      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
      panel.dataset.placement = placement;
      panel.style.setProperty('--popover-arrow-left', `${arrowLeft}px`);
    };
    const show = () => {
      cancelHide();
      panel.classList.add('is-visible');
      panel.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(position);
    };

    trigger.addEventListener('mouseenter', show);
    trigger.addEventListener('mouseleave', scheduleHide);
    trigger.addEventListener('focus', show);
    trigger.addEventListener('blur', scheduleHide);
    trigger.addEventListener('click', event => {
      event.preventDefault();
      pinned = !pinned;
      if (pinned) show();
      else close();
    });
    panel.addEventListener('mouseenter', cancelHide);
    panel.addEventListener('mouseleave', scheduleHide);
    window.addEventListener('resize', position);
    scrollContainer?.addEventListener('scroll', position, { passive: true });
  });
  document.querySelectorAll('.blog-article-body pre').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', '复制代码');
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || pre.textContent || '');
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1500);
    });
    pre.appendChild(btn);
  });

  document.querySelectorAll('.article-popover-content img').forEach(img => {
    const frame = document.createElement('span');
    frame.className = 'article-popover-image-frame';
    frame.setAttribute('aria-label', '图片预览，点击查看大图');
    img.replaceWith(frame);
    frame.appendChild(img);
  });

  document.querySelectorAll('.blog-article-body img').forEach(img => img.addEventListener('click', () => {
    const overlay = document.createElement('div');
    overlay.className = 'img-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', '图片预览');

    const lightboxContent = document.createElement('div');
    lightboxContent.className = 'img-lightbox-content';

    const preview = img.cloneNode(true);
    preview.removeAttribute('tabindex');
    preview.removeAttribute('role');
    preview.removeAttribute('aria-label');

    const closeButton = document.createElement('button');
    closeButton.type = 'button';
    closeButton.className = 'img-lightbox-close';
    closeButton.setAttribute('aria-label', '关闭大图');
    closeButton.textContent = '×';

    const closeLightbox = () => {
      overlay.remove();
      document.removeEventListener('keydown', handleEscape);
      img.focus({ preventScroll: true });
    };
    const handleEscape = event => {
      if (event.key === 'Escape') closeLightbox();
    };

    lightboxContent.append(preview, closeButton);
    overlay.append(lightboxContent);
    overlay.addEventListener('click', event => {
      if (event.target === overlay) closeLightbox();
    });
    closeButton.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', handleEscape);
    document.body.appendChild(overlay);
    closeButton.focus();
  }));

  document.querySelectorAll('.blog-article-body img').forEach(img => {
    img.setAttribute('tabindex', '0');
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', '查看大图');
    img.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      img.click();
    });
  });
</script>
