---
import { entryTimestamp } from '../data/dates.js';
import { coverRatio, coverTheme, coverTitleParts } from '../data/cover-themes.js';
import BoardTabs from './BoardTabs.astro';

interface TimelineEntry {
  title: string;
  description?: string;
  date: string;
  updated?: string;
  category: string;
  subcategories: string[];
  href: string;
}

interface Board {
  id: string;
  name: string;
  href: string;
}

interface Props {
  entries: TimelineEntry[];
  boards: Board[];
  base: string;
}

const { entries, boards, base } = Astro.props;

const versionParts = (title: string) => {
  const match = title.match(/v(\d+)\.(\d+)\.(\d+)/i);
  return match ? match.slice(1).map(Number) : [0, 0, 0];
};

const compareVersion = (a: string, b: string) => {
  const va = versionParts(a);
  const vb = versionParts(b);
  for (let index = 0; index < 3; index += 1) {
    if (va[index] !== vb[index]) return vb[index] - va[index];
  }
  return 0;
};

const visibleEntries = [...entries].sort((a, b) => {
  const dateOrder = entryTimestamp(b.updated || b.date) - entryTimestamp(a.updated || a.date);
  return dateOrder || compareVersion(a.title, b.title) || a.title.localeCompare(b.title, 'zh-CN');
});

const categoryCounts = new Map<string, number>();
const subcategorySet = new Set<string>();
for (const entry of visibleEntries) {
  categoryCounts.set(entry.category, (categoryCounts.get(entry.category) || 0) + 1);
  entry.subcategories.forEach((subcategory) => subcategorySet.add(subcategory));
}

const categories = [...categoryCounts.keys()].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const subcategories = [...subcategorySet].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const cards = visibleEntries.map((entry) => {
  const theme = coverTheme(entry.category);
  const subcategoryLabel = entry.subcategories.join(' · ');
  const parts = coverTitleParts(entry.title, subcategoryLabel);
  const version = versionParts(entry.title).join('.');
  return {
    ...entry,
    theme,
    parts,
    ratio: coverRatio(entry.title),
    dateTs: entryTimestamp(entry.date),
    updatedTs: entryTimestamp(entry.updated || entry.date),
    subcategoryLabel,
    version,
  };
});
---

<section class="note-wall-page timeline-wall" data-timeline-wall>
  <header class="note-wall-header">
    <div class="wall-mobile-topbar">
      <BoardTabs boards={boards} current="timeline" />

      <button class="wall-mobile-search-toggle" type="button" aria-label="打开搜索" aria-expanded="false" aria-controls="timeline-search-panel" data-timeline-search-toggle>
        <svg class="wall-mobile-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.7" cy="10.7" r="6.4"></circle><path d="m15.6 15.6 4.1 4.1"></path></svg>
        <span class="wall-mobile-search-label">取消</span>
      </button>

      <div class="wall-search-frame" id="timeline-search-panel">
        <div class="wall-search-main">
          <svg class="wall-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.7" cy="10.7" r="6.4"></circle><path d="m15.6 15.6 4.1 4.1"></path></svg>
          <input type="search" class="wall-search-input" placeholder="搜索标题、描述或标签" autocomplete="off" aria-label="搜索开发时间线" data-timeline-search-input />
          <button class="wall-search-action" type="button" aria-label="搜索" data-timeline-search-action>
            <svg class="wall-search-action-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.7" cy="10.7" r="6.4"></circle><path d="m15.6 15.6 4.1 4.1"></path></svg>
            <span class="wall-search-action-clear" aria-hidden="true">✕</span>
          </button>
        </div>
        <div class="wall-search-footer">
          <span class="wall-search-divider" aria-hidden="true"></span>
          <span class="wall-search-chip">开发时间线</span>
          <span class="wall-search-hit" data-timeline-hit>当前命中 {cards.length} 篇</span>
        </div>
      </div>
    </div>

    <div class="wall-filter-row timeline-filter-row">
      <div class="wall-pills" role="group" aria-label="项目分类">
        <button class="wall-pill is-active" type="button" data-timeline-category="" aria-pressed="true">全部<small>{cards.length}</small></button>
        {categories.map((category) => (
          <button class="wall-pill" type="button" data-timeline-category={category} aria-pressed="false">
            {category}<small>{categoryCounts.get(category)}</small>
          </button>
        ))}
      </div>
      <button class="wall-pill wall-pill--filter" type="button" data-timeline-filter-toggle aria-expanded="false">
        <span>变更类型</span><small data-timeline-filter-count hidden>0</small>
      </button>
      <button class="wall-pill wall-pill--sort" type="button" data-timeline-sort-toggle aria-label="排序">↕<span>排序</span></button>
    </div>
  </header>

  {cards.length > 0 ? (
    <div class="note-wall" data-timeline-list>
      {cards.map((card) => (
        <a class="note-card" href={card.href} data-title={card.title} data-desc={card.description || ''} data-category={card.category} data-subcategories={card.subcategories.join('|')} data-date-ts={card.dateTs} data-updated-ts={card.updatedTs} data-version={card.version}>
          <div class="note-cover" style={`--cover-bg:${card.theme.bg};--cover-ink:${card.theme.ink};--cover-accent:${card.theme.accent};--cover-quote:${card.theme.quote};--cover-ratio:${card.ratio}`}>
            <span class="note-cover-quote" aria-hidden="true">“</span>
            <strong class="note-cover-title">
              {card.parts.lead && <span class="note-cover-line note-cover-line--lead">{card.parts.lead}</span>}
              <span class="note-cover-line">{card.parts.main}</span>
            </strong>
            <span class="note-cover-rule" aria-hidden="true"></span>
          </div>
          <div class="note-card-body">
            <strong class="note-card-title">{card.title}</strong>
            {card.description && <p class="note-card-desc">{card.description}</p>}
            <div class="note-card-tags">
              <span class="note-card-category">{card.category}</span>
              {card.subcategories.map((subcategory) => <span class="note-card-sub">{subcategory}</span>)}
            </div>
            <span class="note-card-date">{card.date}</span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="placeholder-box"><strong>暂无时间线记录</strong><span>后续版本记录会自动生成详情页。</span></div>
  )}

  <section class="empty-state wall-empty-state" data-timeline-empty hidden>没有匹配的时间线记录</section>

  <div class="float-panel timeline-filter-panel" data-timeline-filter-panel hidden>
    <div class="float-panel-header"><span class="float-panel-title">变更类型</span><button class="float-panel-close" type="button" data-timeline-filter-close aria-label="关闭筛选">✕</button></div>
    <div class="timeline-filter-options">
      <button class="timeline-filter-option is-active" type="button" data-timeline-subcategory="">全部变更类型</button>
      {subcategories.map((subcategory) => <button class="timeline-filter-option" type="button" data-timeline-subcategory={subcategory}>{subcategory}</button>)}
    </div>
  </div>

  <div class="float-panel timeline-sort-panel" data-timeline-sort-panel hidden>
    <div class="float-panel-header"><span class="float-panel-title">排序</span><button class="float-panel-close" type="button" data-timeline-sort-close aria-label="关闭排序">✕</button></div>
    <div class="sort-options">
      <button class="sort-option on" type="button" data-timeline-sort="updated-desc"><span>↓</span><span>最新优先</span></button>
      <button class="sort-option" type="button" data-timeline-sort="updated-asc"><span>↑</span><span>最早优先</span></button>
      <button class="sort-option" type="button" data-timeline-sort="version-desc"><span>v</span><span>版本优先</span></button>
      <button class="sort-option" type="button" data-timeline-sort="title-az"><span>A→Z</span><span>标题 A→Z</span></button>
    </div>
  </div>
</section>

<script>
  function initTimelineWall(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('[data-timeline-list]');
    const empty = root.querySelector<HTMLElement>('[data-timeline-empty]');
    const input = root.querySelector<HTMLInputElement>('[data-timeline-search-input]');
    const action = root.querySelector<HTMLButtonElement>('[data-timeline-search-action]');
    const searchToggle = root.querySelector<HTMLButtonElement>('[data-timeline-search-toggle]');
    const hit = root.querySelector<HTMLElement>('[data-timeline-hit]');
    const cards = [...root.querySelectorAll<HTMLElement>('.note-card')];
    if (!list) return;

    const collator = new Intl.Collator('zh-CN', { numeric: true, sensitivity: 'base' });
    const storageKey = 'devnotes-timeline-wall-state';
    let term = '';
    let category = '';
    let subcategory = '';
    let sortMode = 'updated-desc';

    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
      term = typeof saved.term === 'string' ? saved.term : '';
      category = typeof saved.category === 'string' ? saved.category : '';
      subcategory = typeof saved.subcategory === 'string' ? saved.subcategory : '';
      sortMode = ['updated-desc', 'updated-asc', 'version-desc', 'title-az'].includes(saved.sortMode) ? saved.sortMode : 'updated-desc';
      if (input) input.value = term;
    } catch {
      // 浏览器禁用本地存储时，继续使用本次页面会话状态。
    }

    function saveState() {
      try { localStorage.setItem(storageKey, JSON.stringify({ term, category, subcategory, sortMode })); } catch { /* ignore */ }
    }

    function setSearchOpen(open: boolean) {
      root.classList.toggle('is-mobile-search-open', open);
      searchToggle?.setAttribute('aria-expanded', String(open));
      searchToggle?.setAttribute('aria-label', open ? '收起搜索' : '打开搜索');
      if (open) window.setTimeout(() => input?.focus(), 0);
      else { input?.blur(); searchToggle?.blur(); }
    }

    function versionValue(card: HTMLElement) {
      return (card.dataset.version || '0.0.0').split('.').map(Number);
    }

    function sortCards(items: HTMLElement[]) {
      return [...items].sort((a, b) => {
        if (sortMode === 'title-az') return collator.compare(a.dataset.title || '', b.dataset.title || '');
        if (sortMode === 'version-desc') {
          const va = versionValue(a); const vb = versionValue(b);
          for (let index = 0; index < 3; index += 1) if (va[index] !== vb[index]) return vb[index] - va[index];
        }
        const left = Number(a.dataset.updatedTs) || 0;
        const right = Number(b.dataset.updatedTs) || 0;
        return (sortMode === 'updated-asc' ? left - right : right - left) || collator.compare(a.dataset.title || '', b.dataset.title || '');
      });
    }

    function syncCategoryButtons() {
      root.querySelectorAll<HTMLElement>('[data-timeline-category]').forEach((button) => {
        const active = (button.dataset.timelineCategory || '') === category;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    function syncSubcategoryButtons() {
      root.querySelectorAll<HTMLElement>('[data-timeline-subcategory]').forEach((button) => {
        button.classList.toggle('is-active', (button.dataset.timelineSubcategory || '') === subcategory);
      });
      const count = root.querySelector<HTMLElement>('[data-timeline-filter-count]');
      if (count) { count.textContent = subcategory ? '1' : '0'; count.hidden = !subcategory; }
    }

    function syncAction() {
      const hasTerm = Boolean(term);
      action?.classList.toggle('has-term', hasTerm);
      action?.setAttribute('aria-label', hasTerm ? '清除搜索' : '搜索');
    }

    function apply() {
      const matched = cards.filter((card) => {
        if (category && card.dataset.category !== category) return false;
        if (subcategory && !((card.dataset.subcategories || '').split('|').includes(subcategory))) return false;
        if (!term) return true;
        return [card.dataset.title, card.dataset.desc, card.dataset.category, card.dataset.subcategories].filter(Boolean).join(' ').toLowerCase().includes(term);
      });
      cards.forEach((card) => { card.style.display = 'none'; });
      sortCards(matched).forEach((card) => { list.append(card); card.style.display = ''; });
      if (empty) empty.hidden = matched.length > 0;
      if (hit) hit.textContent = `当前命中 ${matched.length} 篇`;
      saveState();
    }

    function closePanel(panel: HTMLElement | null, trigger: HTMLElement | null) {
      if (!panel) return;
      panel.classList.remove('open');
      trigger?.classList.remove('is-active');
      window.setTimeout(() => { panel.hidden = true; }, 180);
    }

    searchToggle?.addEventListener('click', () => setSearchOpen(!root.classList.contains('is-mobile-search-open')));
    input?.addEventListener('input', () => { term = input.value.trim().toLowerCase(); syncAction(); apply(); });
    action?.addEventListener('click', () => {
      if (!input) return;
      if (!term) { input.focus(); return; }
      input.value = ''; term = ''; syncAction(); input.focus(); apply();
    });

    root.querySelectorAll<HTMLElement>('[data-timeline-category]').forEach((button) => button.addEventListener('click', () => {
      category = button.dataset.timelineCategory || '';
      syncCategoryButtons();
      apply();
    }));

    const filterPanel = root.querySelector<HTMLElement>('[data-timeline-filter-panel]');
    const filterToggle = root.querySelector<HTMLButtonElement>('[data-timeline-filter-toggle]');
    const filterClose = root.querySelector<HTMLElement>('[data-timeline-filter-close]');
    const toggleFilterPanel = () => {
      if (!filterPanel) return;
      if (!filterPanel.hidden) return closePanel(filterPanel, filterToggle);
      filterPanel.hidden = false; filterToggle?.classList.add('is-active'); requestAnimationFrame(() => filterPanel.classList.add('open'));
    };
    filterToggle?.addEventListener('click', toggleFilterPanel);
    filterClose?.addEventListener('click', () => closePanel(filterPanel, filterToggle));
    root.querySelectorAll<HTMLElement>('[data-timeline-subcategory]').forEach((button) => button.addEventListener('click', () => {
      subcategory = button.dataset.timelineSubcategory || '';
      syncSubcategoryButtons();
      closePanel(filterPanel, filterToggle);
      apply();
    }));

    const sortPanel = root.querySelector<HTMLElement>('[data-timeline-sort-panel]');
    const sortToggle = root.querySelector<HTMLButtonElement>('[data-timeline-sort-toggle]');
    const sortClose = root.querySelector<HTMLElement>('[data-timeline-sort-close]');
    sortToggle?.addEventListener('click', () => {
      if (!sortPanel) return;
      if (!sortPanel.hidden) return closePanel(sortPanel, sortToggle);
      sortPanel.hidden = false; sortToggle.classList.add('is-active'); requestAnimationFrame(() => sortPanel.classList.add('open'));
    });
    sortClose?.addEventListener('click', () => closePanel(sortPanel, sortToggle));
    root.querySelectorAll<HTMLElement>('[data-timeline-sort]').forEach((button) => button.addEventListener('click', () => {
      root.querySelectorAll('[data-timeline-sort]').forEach((item) => item.classList.remove('on'));
      button.classList.add('on'); sortMode = button.dataset.timelineSort || 'updated-desc';
      closePanel(sortPanel, sortToggle); apply();
    }));

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (!target.closest('[data-timeline-filter-panel]') && !target.closest('[data-timeline-filter-toggle]')) closePanel(filterPanel, filterToggle);
      if (!target.closest('[data-timeline-sort-panel]') && !target.closest('[data-timeline-sort-toggle]')) closePanel(sortPanel, sortToggle);
    });

    const ENTER = 160;
    const EXIT = 6;
    let frame = 0;
    window.addEventListener('scroll', () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => { frame = 0; const current = root.classList.contains('is-scrolled'); const next = window.scrollY > (current ? EXIT : ENTER); if (next !== current) root.classList.toggle('is-scrolled', next); });
    }, { passive: true });

    syncCategoryButtons();
    syncSubcategoryButtons();
    syncAction();
    root.querySelectorAll<HTMLElement>('[data-timeline-sort]').forEach((button) => button.classList.toggle('on', button.dataset.timelineSort === sortMode));
    apply();
  }

  document.querySelectorAll<HTMLElement>('[data-timeline-wall]').forEach(initTimelineWall);
</script>
