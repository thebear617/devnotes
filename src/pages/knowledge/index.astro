---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('knowledge');
entries.sort((a, b) => new Date(b.data.updated || b.data.date).getTime() - new Date(a.data.updated || a.data.date).getTime());

const PRIMARY_CATEGORIES = ['开发与实践', '科研', '随想'];
const SUBCATEGORIES = ['基础知识', '典型案例', '学习资源', '配置记录', '综述', '随笔', '时刻'];
const subcategories = SUBCATEGORIES.filter(subcategory => entries.some(entry => entry.data.subcategory === subcategory));
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
  <main class="app-shell">
    <h2 class="view-title">知识库</h2>
    <p class="view-sub">开发与实践 · 科研 · 随想</p>

    <div class="knowledge-toolbar">
      <div class="list-search" id="knowledgeSearch">
        <span class="list-search-icon">🔍</span>
        <input type="search" id="knowledgeSearchInput" class="list-search-input" placeholder="搜索标题、描述或分类" autocomplete="off" aria-label="搜索知识库" />
        <button class="list-search-clear" id="knowledgeSearchClear" aria-label="清除搜索">✕</button>
      </div>
      <button class="knowledge-sort" id="knowledgeSort" type="button" aria-pressed="false" title="切换知识库排序方式">
        <span aria-hidden="true">↕</span>
        <span id="knowledgeSortLabel">最近更新</span>
      </button>
    </div>

    {entries.length > 0 && (
      <div class="filter-bar">
        <div class="filter-row">
          <span class="filter-label">分类</span>
          <div class="filter-tags" data-filter="category">
            {PRIMARY_CATEGORIES.map(category => <button class="filter-tag" data-filter-value={category}>{category}</button>)}
          </div>
        </div>
        <div class="filter-row">
          <span class="filter-label">子分类</span>
          <div class="filter-tags" data-filter="subcategory">
            {subcategories.map(subcategory => <button class="filter-tag" data-filter-value={subcategory}>{subcategory}</button>)}
            <button class="filter-clear" id="filterClear">清除筛选</button>
          </div>
        </div>
      </div>
    )}

    {entries.length > 0 ? (
      <div class="blog-list" id="knowledgeList">
        {entries.map(entry => (
          <a
            href={`${base}knowledge/${entry.data.slug || entry.id}/`}
            class="blog-card"
            data-category={entry.data.category}
            data-subcategory={entry.data.subcategory || ''}
            data-title={entry.data.title}
            data-date={entry.data.date}
            data-updated={entry.data.updated || entry.data.date}
            data-search={[entry.data.title, entry.data.description, entry.data.category, entry.data.subcategory].filter(Boolean).join(' ')}
          >
            <div class="blog-card-title">{entry.data.title}</div>
            {entry.data.description && <p class="blog-card-desc">{entry.data.description}</p>}
            <div class="blog-card-meta">{entry.data.date}</div>
            <div class="blog-card-tags">
              <span class="blog-tag category-tag category-knowledge">{entry.data.category}</span>
              {entry.data.subcategory && <span class="blog-tag">{entry.data.subcategory}</span>}
            </div>
          </a>
        ))}
      </div>
      <nav class="list-pagination" id="knowledgePagination" aria-label="知识库分页" hidden>
        <button class="list-page-button" id="knowledgePrevPage" type="button">← 上一页</button>
        <div class="list-page-numbers" id="knowledgePageNumbers"></div>
        <button class="list-page-button" id="knowledgeNextPage" type="button">下一页 →</button>
      </nav>
    ) : <section class="empty-state">还没有知识条目</section>}

    <section class="empty-state" id="emptyState" style="display:none">没有匹配的知识条目</section>
  </main>
</Layout>

<script>
  let filters = {};
  let searchTerm = '';
  let sortMode = 'updated-desc';
  let currentPage = 1;
  const pageSize = 8;
  const cards = [...document.querySelectorAll('#knowledgeList .blog-card')];
  const knowledgeList = document.getElementById('knowledgeList');
  const subcategoryTags = [...document.querySelectorAll('[data-filter="subcategory"] .filter-tag')];
  const sortButton = document.getElementById('knowledgeSort');
  const sortLabel = document.getElementById('knowledgeSortLabel');
  const originalOrder = new Map(cards.map((card, index) => [card, index]));
  const titleCollator = new Intl.Collator('zh-CN', { numeric: true, sensitivity: 'base' });

  function syncSubcategoryOptions() {
    const availableSubcategories = new Set(
      cards
        .filter(card => !filters.category || card.dataset.category === filters.category)
        .map(card => card.dataset.subcategory)
        .filter(Boolean),
    );

    subcategoryTags.forEach(tag => {
      const visible = availableSubcategories.has(tag.dataset.filterValue);
      tag.hidden = !visible;
      if (!visible && tag.classList.contains('on')) {
        tag.classList.remove('on');
        if (filters.subcategory === tag.dataset.filterValue) delete filters.subcategory;
      }
    });
  }

  document.querySelectorAll('.filter-bar .filter-tag').forEach(tag => {
    tag.addEventListener('click', () => {
      const row = tag.closest('.filter-row');
      const filterKey = row.querySelector('.filter-tags').dataset.filter;
      const on = tag.classList.toggle('on');
      if (on) {
        row.querySelectorAll('.filter-tag').forEach(other => { if (other !== tag) other.classList.remove('on'); });
        filters[filterKey] = tag.dataset.filterValue;
      } else delete filters[filterKey];
      if (filterKey === 'category') syncSubcategoryOptions();
      resetToFirstPage();
    });
  });

  document.getElementById('filterClear')?.addEventListener('click', () => {
    document.querySelectorAll('.filter-bar .filter-tag.on').forEach(tag => tag.classList.remove('on'));
    filters = {};
    syncSubcategoryOptions();
    resetToFirstPage();
  });

  const searchInput = document.getElementById('knowledgeSearchInput');
  const searchClear = document.getElementById('knowledgeSearchClear');
  searchInput?.addEventListener('input', () => {
    searchTerm = searchInput.value.trim().toLowerCase();
    searchClear.style.display = searchTerm ? '' : 'none';
    resetToFirstPage();
  });
  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    searchClear.style.display = 'none';
    searchInput.focus();
    resetToFirstPage();
  });

  sortButton?.addEventListener('click', () => {
    sortMode = sortMode === 'updated-desc' ? 'title-asc' : 'updated-desc';
    sortButton.setAttribute('aria-pressed', String(sortMode === 'title-asc'));
    if (sortLabel) sortLabel.textContent = sortMode === 'title-asc' ? '名称排序' : '最近更新';
    resetToFirstPage();
  });

  document.getElementById('knowledgePrevPage')?.addEventListener('click', () => {
    currentPage -= 1;
    applyFilters({ scrollToList: true });
  });

  document.getElementById('knowledgeNextPage')?.addEventListener('click', () => {
    currentPage += 1;
    applyFilters({ scrollToList: true });
  });

  document.getElementById('knowledgePageNumbers')?.addEventListener('click', event => {
    const page = Number(event.target.closest('[data-page]')?.dataset.page);
    if (!page || page === currentPage) return;
    currentPage = page;
    applyFilters({ scrollToList: true });
  });

  function resetToFirstPage() {
    currentPage = 1;
    applyFilters();
  }

  function compareCards(a, b) {
    if (sortMode === 'title-asc') {
      return titleCollator.compare(a.dataset.title || '', b.dataset.title || '')
        || originalOrder.get(a) - originalOrder.get(b);
    }

    const updatedDifference = (Date.parse(b.dataset.updated || '') || 0) - (Date.parse(a.dataset.updated || '') || 0);
    return updatedDifference || originalOrder.get(a) - originalOrder.get(b);
  }

  function applyFilters({ scrollToList = false } = {}) {
    const orderedCards = [...cards].sort(compareCards);
    knowledgeList?.append(...orderedCards);
    const filtered = orderedCards.filter(card => (
      (!filters.category || card.dataset.category === filters.category)
        && (!filters.subcategory || card.dataset.subcategory === filters.subcategory)
        && (!searchTerm || card.dataset.search.toLowerCase().includes(searchTerm))
    ));
    const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
    currentPage = Math.min(Math.max(currentPage, 1), totalPages);
    const firstIndex = (currentPage - 1) * pageSize;
    const pageCards = new Set(filtered.slice(firstIndex, firstIndex + pageSize));

    cards.forEach(card => {
      card.style.display = pageCards.has(card) ? '' : 'none';
    });

    document.getElementById('emptyState').style.display = filtered.length ? 'none' : '';
    renderPagination(totalPages, filtered.length);

    if (scrollToList) {
      document.getElementById('knowledgeList')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function renderPagination(totalPages, resultCount) {
    const pagination = document.getElementById('knowledgePagination');
    const prev = document.getElementById('knowledgePrevPage');
    const next = document.getElementById('knowledgeNextPage');
    const pageNumbers = document.getElementById('knowledgePageNumbers');
    if (!pagination || !prev || !next || !pageNumbers) return;

    pagination.hidden = resultCount <= pageSize;
    prev.disabled = currentPage === 1;
    next.disabled = currentPage === totalPages;
    pageNumbers.replaceChildren(...Array.from({ length: totalPages }, (_, index) => {
      const page = index + 1;
      const button = document.createElement('button');
      button.className = `list-page-number${page === currentPage ? ' on' : ''}`;
      button.type = 'button';
      button.dataset.page = String(page);
      button.textContent = String(page);
      if (page === currentPage) button.setAttribute('aria-current', 'page');
      return button;
    }));
  }

  syncSubcategoryOptions();
  applyFilters();
</script>
