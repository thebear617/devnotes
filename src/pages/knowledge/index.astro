---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { entryTimestamp } from '../../data/dates.js';

const entries = await getCollection('knowledge');
entries.sort((a, b) => entryTimestamp(b.data.updated || b.data.date) - entryTimestamp(a.data.updated || a.data.date));

const PRIMARY_CATEGORIES = ['开发', '实践', '科研', '随想'];
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
  <main class="app-shell">
    <h2 class="view-title">知识库</h2>
    <p class="view-sub">开发 · 实践 · 科研 · 随想</p>
    <p class="debug-guideline">标题命名规范：<code>内容类型：主题对象 - 具体内容</code></p>

    <div class="knowledge-toolbar">
      <div class="list-search" id="knowledgeSearch">
        <span class="list-search-icon">🔍</span>
        <input type="search" id="knowledgeSearchInput" class="list-search-input" placeholder="搜索标题、描述或分类" autocomplete="off" aria-label="搜索知识库" />
        <button class="list-search-clear" id="knowledgeSearchClear" aria-label="清除搜索">✕</button>
      </div>
      <div class="knowledge-actions">
        <button class="knowledge-sort" id="knowledgeSort" type="button" aria-pressed="false" title="切换知识库排序方式">
          <span aria-hidden="true">↕</span>
          <span id="knowledgeSortLabel">最近更新</span>
        </button>
        {entries.length > 0 && (
          <button class="filter-trigger" id="knowledgeFilterTrigger" type="button" aria-expanded="false" aria-controls="knowledgeFilterModal">
            <span aria-hidden="true">☷</span>
            <span class="filter-trigger-label">筛选</span>
            <span class="filter-badge" id="knowledgeFilterBadge" hidden>0</span>
          </button>
        )}
        <button class="view-toggle" id="knowledgeViewToggle" type="button" aria-pressed="false" title="切换到宫格视图">
          <span class="view-toggle-icon" aria-hidden="true">▦</span>
          <span id="knowledgeViewToggleLabel">宫格视图</span>
        </button>
      </div>
    </div>

    {entries.length > 0 && (
      <>
        <div class="filter-backdrop" id="knowledgeFilterBackdrop" hidden></div>
        <section class="filter-modal knowledge-filter-modal" id="knowledgeFilterModal" hidden role="dialog" aria-modal="true" aria-labelledby="knowledgeFilterTitle">
          <header class="filter-modal-header">
            <div>
              <h3 id="knowledgeFilterTitle">筛选知识库</h3>
              <p>先选择一级领域，再缩小到对应的二级内容角色。</p>
            </div>
            <button class="filter-modal-close" id="knowledgeFilterClose" type="button" aria-label="关闭筛选">×</button>
          </header>
          <div class="filter-modal-body knowledge-filter-options">
            <div class="filter-fields">
              <div class="filter-field">
                <span>一级分类</span>
                <div class="custom-select" data-custom-select="knowledge-category">
                  <select class="custom-select-native" id="knowledge-category" aria-hidden="true" tabindex="-1">
                    <option value="">全部分类</option>
                    {PRIMARY_CATEGORIES.map(category => <option value={category}>{category}</option>)}
                  </select>
                  <button class="custom-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="一级分类">
                    <span class="custom-select-label">全部分类</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <div class="custom-select-menu" role="listbox" hidden></div>
                </div>
              </div>
              <div class="filter-field">
                <span>二级分类</span>
                <div class="custom-select" data-custom-select="knowledge-subcategory">
                  <select class="custom-select-native" id="knowledge-subcategory" aria-hidden="true" tabindex="-1" disabled>
                    <option value="">请先选择一级分类</option>
                  </select>
                  <button class="custom-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="二级分类" disabled>
                    <span class="custom-select-label">请先选择一级分类</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <div class="custom-select-menu" role="listbox" hidden></div>
                </div>
              </div>
            </div>
          </div>
          <footer class="filter-modal-footer">
            <button class="filter-modal-clear" id="filterClear" type="button">清除筛选</button>
            <button class="filter-modal-done" id="knowledgeFilterDone" type="button">完成</button>
          </footer>
        </section>
      </>
    )}

    {entries.length > 0 ? (
      <div class="blog-list" id="knowledgeList">
        {entries.map(entry => (
          <a
            href={`${base}knowledge/${entry.data.slug || entry.id}/`}
            class="blog-card"
            data-category={entry.data.category}
            data-subcategory={entry.data.subcategory || ''}
            data-title={entry.data.title}
            data-date={entry.data.date}
            data-updated={entry.data.updated || entry.data.date}
            data-updated-ts={entryTimestamp(entry.data.updated || entry.data.date)}
            data-search={[entry.data.title, entry.data.description, entry.data.category, entry.data.subcategory].filter(Boolean).join(' ')}
          >
            <div class="blog-card-title">{entry.data.title}</div>
            {entry.data.description && <p class="blog-card-desc">{entry.data.description}</p>}
            <div class="blog-card-meta">{entry.data.date}</div>
            <div class="blog-card-tags">
              <span class="blog-tag category-tag category-knowledge">{entry.data.category}</span>
              {entry.data.subcategory && <span class="blog-tag blog-tag-subcategory">{entry.data.subcategory}</span>}
            </div>
          </a>
        ))}
      </div>
      <nav class="list-pagination" id="knowledgePagination" aria-label="知识库分页" hidden>
        <button class="list-page-button" id="knowledgePrevPage" type="button">← 上一页</button>
        <div class="list-page-numbers" id="knowledgePageNumbers"></div>
        <button class="list-page-button" id="knowledgeNextPage" type="button">下一页 →</button>
      </nav>
    ) : <section class="empty-state">还没有知识条目</section>}

    <section class="empty-state" id="emptyState" style="display:none">没有匹配的知识条目</section>
  </main>
</Layout>

<script>
  let filters = {};
  let searchTerm = '';
  let sortMode = 'updated-desc';
  let currentPage = 1;
  const pageSizes = { grid: 12, list: 8 };
  const cards = [...document.querySelectorAll('#knowledgeList .blog-card')];
  const knowledgeList = document.getElementById('knowledgeList');
  const categorySelect = document.getElementById('knowledge-category');
  const subcategorySelect = document.getElementById('knowledge-subcategory');
  const sortButton = document.getElementById('knowledgeSort');
  const sortLabel = document.getElementById('knowledgeSortLabel');
  const filterTrigger = document.getElementById('knowledgeFilterTrigger');
  const filterBadge = document.getElementById('knowledgeFilterBadge');
  const filterModal = document.getElementById('knowledgeFilterModal');
  const filterBackdrop = document.getElementById('knowledgeFilterBackdrop');
  const viewToggle = document.getElementById('knowledgeViewToggle');
  const viewToggleIcon = document.querySelector('#knowledgeViewToggle .view-toggle-icon');
  const viewToggleLabel = document.getElementById('knowledgeViewToggleLabel');
  const originalOrder = new Map(cards.map((card, index) => [card, index]));
  const titleCollator = new Intl.Collator('zh-CN', { numeric: true, sensitivity: 'base' });
  let viewMode = 'list';

  try {
    viewMode = localStorage.getItem('devnotes-knowledge-view') === 'grid' ? 'grid' : 'list';
  } catch {
    viewMode = 'list';
  }

  function applyViewMode() {
    const isGrid = viewMode === 'grid';
    knowledgeList?.classList.toggle('is-grid', isGrid);
    viewToggle?.setAttribute('aria-pressed', String(isGrid));
    viewToggle?.setAttribute('title', isGrid ? '切换到列表视图' : '切换到宫格视图');
    if (viewToggleIcon) viewToggleIcon.textContent = isGrid ? '☷' : '▦';
    if (viewToggleLabel) viewToggleLabel.textContent = isGrid ? '列表视图' : '宫格视图';
  }

  function updateFilterTrigger() {
    const count = Object.keys(filters).length;
    filterTrigger?.classList.toggle('active', count > 0);
    if (filterBadge) {
      filterBadge.textContent = String(count);
      filterBadge.hidden = count === 0;
    }
  }

  function setFilterOpen(open) {
    if (!filterModal || !filterBackdrop) return;
    closeCustomSelects();
    filterModal.hidden = !open;
    filterBackdrop.hidden = !open;
    filterTrigger?.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('filter-open', open);
    if (open) filterModal.querySelector('.custom-select-trigger')?.focus();
  }

  function customSelectRoot(id) {
    return document.querySelector(`[data-custom-select="${id}"]`);
  }

  function closeCustomSelects(except = null) {
    document.querySelectorAll('.custom-select.open').forEach(root => {
      if (root === except) return;
      root.classList.remove('open');
      root.querySelector('.custom-select-menu').hidden = true;
      root.querySelector('.custom-select-trigger').setAttribute('aria-expanded', 'false');
    });
  }

  function syncCustomSelect(id) {
    const select = document.getElementById(id);
    const root = customSelectRoot(id);
    if (!select || !root) return;
    const trigger = root.querySelector('.custom-select-trigger');
    const label = root.querySelector('.custom-select-label');
    const menu = root.querySelector('.custom-select-menu');
    const selected = [...select.options].find(option => option.value === select.value) || select.options[0];
    label.textContent = selected?.textContent || '';
    trigger.disabled = select.disabled;
    if (select.disabled) {
      root.classList.remove('open');
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    }
    menu.replaceChildren(...[...select.options].map(option => {
      const item = document.createElement('button');
      item.className = `custom-select-option${option.value === select.value ? ' is-selected' : ''}`;
      item.type = 'button';
      item.setAttribute('role', 'option');
      item.setAttribute('aria-selected', String(option.value === select.value));
      item.textContent = option.textContent;
      item.addEventListener('click', event => {
        event.stopPropagation();
        if (select.disabled) return;
        select.value = option.value;
        syncCustomSelect(id);
        select.dispatchEvent(new Event('change', { bubbles: true }));
        closeCustomSelects();
      });
      return item;
    }));
  }

  function initializeCustomSelects() {
    document.querySelectorAll('[data-custom-select]').forEach(root => {
      const id = root.dataset.customSelect;
      const select = document.getElementById(id);
      const trigger = root.querySelector('.custom-select-trigger');
      const menu = root.querySelector('.custom-select-menu');
      trigger.addEventListener('click', event => {
        event.stopPropagation();
        if (select.disabled) return;
        const shouldOpen = menu.hidden;
        closeCustomSelects(root);
        menu.hidden = !shouldOpen;
        root.classList.toggle('open', shouldOpen);
        trigger.setAttribute('aria-expanded', String(shouldOpen));
      });
      menu.addEventListener('click', event => event.stopPropagation());
      syncCustomSelect(id);
    });
  }

  function populateSubcategoryOptions() {
    const category = categorySelect?.value || '';
    const currentSubcategory = subcategorySelect?.value || '';
    const availableSubcategories = new Set(
      cards
        .filter(card => category && card.dataset.category === category)
        .map(card => card.dataset.subcategory)
        .filter(Boolean),
    );
    const values = [...availableSubcategories].sort((left, right) => left.localeCompare(right, 'zh-CN'));
    if (!subcategorySelect) return;
    subcategorySelect.innerHTML = '';
    const emptyOption = document.createElement('option');
    emptyOption.value = '';
    emptyOption.textContent = category ? '全部二级分类' : '请先选择一级分类';
    subcategorySelect.append(emptyOption);
    values.forEach(value => {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = value;
      subcategorySelect.append(option);
    });
    subcategorySelect.disabled = !category;
    subcategorySelect.value = values.includes(currentSubcategory) ? currentSubcategory : '';
    syncCustomSelect('knowledge-subcategory');
  }

  function updateFilterState() {
    filters = {};
    if (categorySelect?.value) filters.category = categorySelect.value;
    if (subcategorySelect?.value) filters.subcategory = subcategorySelect.value;
    updateFilterTrigger();
  }

  categorySelect?.addEventListener('change', () => {
    if (subcategorySelect) subcategorySelect.value = '';
    populateSubcategoryOptions();
    updateFilterState();
    resetToFirstPage();
  });

  subcategorySelect?.addEventListener('change', () => {
    updateFilterState();
    resetToFirstPage();
  });

  document.getElementById('filterClear')?.addEventListener('click', () => {
    if (categorySelect) categorySelect.value = '';
    populateSubcategoryOptions();
    updateFilterState();
    resetToFirstPage();
  });

  filterTrigger?.addEventListener('click', () => setFilterOpen(filterModal?.hidden ?? true));
  document.getElementById('knowledgeFilterClose')?.addEventListener('click', () => setFilterOpen(false));
  document.getElementById('knowledgeFilterDone')?.addEventListener('click', () => setFilterOpen(false));
  filterBackdrop?.addEventListener('click', () => setFilterOpen(false));
  document.addEventListener('click', () => closeCustomSelects());
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && filterModal && !filterModal.hidden) setFilterOpen(false);
  });

  const searchInput = document.getElementById('knowledgeSearchInput');
  const searchClear = document.getElementById('knowledgeSearchClear');
  searchInput?.addEventListener('input', () => {
    searchTerm = searchInput.value.trim().toLowerCase();
    searchClear.style.display = searchTerm ? '' : 'none';
    resetToFirstPage();
  });
  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    searchClear.style.display = 'none';
    searchInput.focus();
    resetToFirstPage();
  });

  sortButton?.addEventListener('click', () => {
    sortMode = sortMode === 'updated-desc' ? 'title-asc' : 'updated-desc';
    sortButton.setAttribute('aria-pressed', String(sortMode === 'title-asc'));
    if (sortLabel) sortLabel.textContent = sortMode === 'title-asc' ? '名称排序' : '最近更新';
    resetToFirstPage();
  });

  viewToggle?.addEventListener('click', () => {
    viewMode = viewMode === 'grid' ? 'list' : 'grid';
    applyViewMode();
    applyFilters();
    try {
      localStorage.setItem('devnotes-knowledge-view', viewMode);
    } catch {
      // 浏览器禁用本地存储时，仍保留本次页面会话的视图切换。
    }
  });

  document.getElementById('knowledgePrevPage')?.addEventListener('click', () => {
    currentPage -= 1;
    applyFilters({ scrollToList: true });
  });

  document.getElementById('knowledgeNextPage')?.addEventListener('click', () => {
    currentPage += 1;
    applyFilters({ scrollToList: true });
  });

  document.getElementById('knowledgePageNumbers')?.addEventListener('click', event => {
    const page = Number(event.target.closest('[data-page]')?.dataset.page);
    if (!page || page === currentPage) return;
    currentPage = page;
    applyFilters({ scrollToList: true });
  });

  function resetToFirstPage() {
    currentPage = 1;
    applyFilters();
  }

  function compareCards(a, b) {
    if (sortMode === 'title-asc') {
      return titleCollator.compare(a.dataset.title || '', b.dataset.title || '')
        || originalOrder.get(a) - originalOrder.get(b);
    }

    const updatedDifference = (Number(b.dataset.updatedTs) || 0) - (Number(a.dataset.updatedTs) || 0);
    return updatedDifference || originalOrder.get(a) - originalOrder.get(b);
  }

  function applyFilters({ scrollToList = false } = {}) {
    const pageSize = pageSizes[viewMode];
    const orderedCards = [...cards].sort(compareCards);
    knowledgeList?.append(...orderedCards);
    const filtered = orderedCards.filter(card => (
      (!filters.category || card.dataset.category === filters.category)
        && (!filters.subcategory || card.dataset.subcategory === filters.subcategory)
        && (!searchTerm || card.dataset.search.toLowerCase().includes(searchTerm))
    ));
    const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
    currentPage = Math.min(Math.max(currentPage, 1), totalPages);
    const firstIndex = (currentPage - 1) * pageSize;
    const pageCards = new Set(filtered.slice(firstIndex, firstIndex + pageSize));

    cards.forEach(card => {
      card.style.display = pageCards.has(card) ? '' : 'none';
    });

    document.getElementById('emptyState').style.display = filtered.length ? 'none' : '';
    renderPagination(totalPages, filtered.length);

    if (scrollToList) {
      document.getElementById('knowledgeList')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function renderPagination(totalPages, resultCount) {
    const pageSize = pageSizes[viewMode];
    const pagination = document.getElementById('knowledgePagination');
    const prev = document.getElementById('knowledgePrevPage');
    const next = document.getElementById('knowledgeNextPage');
    const pageNumbers = document.getElementById('knowledgePageNumbers');
    if (!pagination || !prev || !next || !pageNumbers) return;

    pagination.hidden = resultCount <= pageSize;
    prev.disabled = currentPage === 1;
    next.disabled = currentPage === totalPages;
    pageNumbers.replaceChildren(...Array.from({ length: totalPages }, (_, index) => {
      const page = index + 1;
      const button = document.createElement('button');
      button.className = `list-page-number${page === currentPage ? ' on' : ''}`;
      button.type = 'button';
      button.dataset.page = String(page);
      button.textContent = String(page);
      if (page === currentPage) button.setAttribute('aria-current', 'page');
      return button;
    }));
  }

  initializeCustomSelects();
  populateSubcategoryOptions();
  updateFilterState();
  applyViewMode();
  applyFilters();
</script>
