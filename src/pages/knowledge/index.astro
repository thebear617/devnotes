---
import Layout from '../../layouts/Layout.astro';
import NoteWall from '../../components/NoteWall.astro';
import { getCollection } from 'astro:content';
import { getBoardNav } from '../../data/board-nav.js';

const entries = await getCollection('knowledge');
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
const boards = getBoardNav(base);
const wallEntries = entries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  updated: entry.data.updated,
  category: entry.data.category,
  subcategory: entry.data.subcategory,
  href: `${base}knowledge/${entry.data.slug || entry.id}/`,
}));
---

<Layout>
  <NoteWall entries={wallEntries} title="知识库" boardId="knowledge" boards={boards} placeholder="开发、实践、科研与个人随想会自动出现在这里。" />
</Layout>
