---
import Layout from '../../layouts/Layout.astro';
import TimelineWall from '../../components/TimelineWall.astro';
import { getBoardNav } from '../../data/board-nav.js';
import { getCollection } from 'astro:content';

const entries = await getCollection('timeline');
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
const boards = getBoardNav(base);
const wallEntries = entries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  updated: entry.data.updated,
  category: entry.data.category,
  subcategories: entry.data.subcategory,
  href: `${base}timeline/${entry.id.replace(/\.md$/, '')}/`,
}));
---

<Layout>
  <TimelineWall entries={wallEntries} boards={boards} base={base} />
</Layout>
