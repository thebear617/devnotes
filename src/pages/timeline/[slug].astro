---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('timeline');
  return entries.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const secondaryCategories = entry.data.subcategory;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
  <main class="app-shell">
    <a href={`${base}timeline/`} class="blog-back">← 返回开发时间线</a>

    <article class="tl-detail">
      <div class="tl-detail-inner">
        <header class="tl-detail-header">
          <div>
            <h1 class="tl-detail-title">{entry.data.title}</h1>
            <p class="tl-detail-description">{entry.data.description}</p>
            <p class="tl-detail-date">{entry.data.date}</p>
          </div>
          <div class="tl-tags">
            <span class="tl-tag tl-tag-site">{entry.data.category}</span>
            {secondaryCategories.map(category => <span class="tl-tag">{category}</span>)}
          </div>
        </header>
        <div class="tl-detail-body">
          <Content />
        </div>
      </div>
    </article>
  </main>
</Layout>

<script>
  const openLightbox = (trigger, src, alt) => {
    const overlay = document.createElement('div');
    overlay.className = 'img-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', '图片预览');

    const lightboxContent = document.createElement('div');
    lightboxContent.className = 'img-lightbox-content';

    const preview = document.createElement('img');
    preview.src = src;
    preview.alt = alt || '图片预览';
    preview.decoding = 'async';

    const closeButton = document.createElement('button');
    closeButton.type = 'button';
    closeButton.className = 'img-lightbox-close';
    closeButton.setAttribute('aria-label', '关闭大图');
    closeButton.textContent = '×';

    const closeLightbox = () => {
      overlay.remove();
      document.removeEventListener('keydown', handleEscape);
      trigger.focus({ preventScroll: true });
    };
    const handleEscape = event => {
      if (event.key === 'Escape') closeLightbox();
    };

    lightboxContent.append(preview, closeButton);
    overlay.append(lightboxContent);
    overlay.addEventListener('click', event => {
      if (event.target === overlay) closeLightbox();
    });
    closeButton.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', handleEscape);
    document.body.appendChild(overlay);
    closeButton.focus();
  };

  document.querySelectorAll('.tl-detail-body img').forEach(img => {
    const showImage = () => openLightbox(img, img.currentSrc || img.src, img.alt);
    img.setAttribute('tabindex', '0');
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', '查看大图');
    img.addEventListener('click', showImage);
    img.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      showImage();
    });
  });

  document.querySelectorAll('.tl-detail-body a.timeline-image-link').forEach(link => {
    const showImage = event => {
      event.preventDefault();
      openLightbox(link, link.href, link.dataset.imageAlt || link.textContent.trim());
    };
    link.addEventListener('click', showImage);
    link.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      showImage(event);
    });
  });
</script>
