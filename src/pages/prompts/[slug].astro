---
import Layout from '../../layouts/Layout.astro';
import KnowledgeDetail from '../../components/KnowledgeDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.filter(entry => entry.data.kind === 'workflow').map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout><KnowledgeDetail entry={entry} backHref={`${base}knowledge/`} backLabel="返回知识库" /></Layout>
