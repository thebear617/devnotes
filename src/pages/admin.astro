  <script define:vars={{ base }}>
    const $ = (id) => document.getElementById(id);
    const apiBase = `${base}admin/api`;
     const SORT_OPTIONS = [
      { value: 'updated-desc', label: '最近更新' },
      { value: 'date-desc', label: '发布日期' },
      { value: 'title-asc', label: '标题 A → Z' },
      { value: 'title-desc', label: '标题 Z → A' },
    ];
     const EDITOR_SESSION_KEY = 'devnotes-admin-editor-state-v1';
     const EDITOR_DRAFT_KEY = 'devnotes-admin-editor-draft-v1';
     const IMMERSIVE_SESSION_KEY = 'devnotes-admin-immersive-v1';
     const IMMERSIVE_WIDE_QUERY = '(min-width: 1181px)';
     const immersiveMedia = window.matchMedia(IMMERSIVE_WIDE_QUERY);
    const state = { collections: [], collectionId: '', entries: [], selectedPath: '', dirty: false, draftVersion: 0, filters: {}, sort: 'updated-desc', previewId: 0 };
    let previewTimer = 0;
    let autoSaveTimer = 0;
    let savePromise = null;
    const AUTO_SAVE_DELAY = 900;
    let selectedPreviewNode = null;
    let selectedPreviewSourceRange = null;
    let pendingScrollRestore = null;
    let syncHighlightTimer = 0;
    let editorState = null;
    let undoStack = [];
    let redoStack = [];
    let isProgrammaticEdit = false;
    const editorHistoryLimit = 100;
    let previewFootnoteCleanup = () => {};
    let activePreviewFootnoteClose = null;
    let deleteReturnFocus = null;
    let deletePromise = null;

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const activeCollection = () => state.collections.find((item) => item.id === state.collectionId);
    const clone = (value) => JSON.parse(JSON.stringify(value));
    const today = () => new Date().toISOString().slice(0, 10);
    const setStatus = (message, kind = '') => { $('status').textContent = message; $('status').className = `status ${kind}`; };

    function managedPathStrategy(config = activeCollection()) {
      return config?.pathStrategy || null;
    }

    function filenameFromTitle(value) {
      const normalized = String(value || '')
        .trim()
        .replaceAll('\0', '')
        .replaceAll('/', '／')
        .replaceAll('\\', '＼')
        .replace(/\.md$/i, '')
        .trim();
      return normalized && normalized !== '.' && normalized !== '..' ? `${normalized}.md` : '';
    }

    function derivedEntryPath(config = activeCollection()) {
      const strategy = managedPathStrategy(config);
      if (!strategy) return $('entry-path')?.value.trim() || '';
      const category = $(`field-${strategy.categoryField}`)?.value;
      const subcategory = $(`field-${strategy.subcategoryField}`)?.value;
      const filename = filenameFromTitle($('field-title')?.value);
      const categoryDirectory = strategy.categoryDirectories?.[category];
      const subcategoryDirectory = strategy.subcategoryDirectories?.[subcategory];
      if (!categoryDirectory || !subcategoryDirectory || !filename || filename.includes('/') || filename.includes('\\')) return '';
      return `${categoryDirectory}/${subcategoryDirectory}/${filename}`;
    }

    function updateDerivedEntryPath() {
      const strategy = managedPathStrategy();
      if (!strategy) return;
      $('entry-path').value = derivedEntryPath();
    }
    function scheduleAutoSave() {
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = 0;
      if (!state.dirty) return;
      autoSaveTimer = window.setTimeout(() => {
        autoSaveTimer = 0;
        void saveEntry();
      }, AUTO_SAVE_DELAY);
    }
    const markDirty = () => {
      state.dirty = true;
      state.draftVersion += 1;
      setStatus('等待自动保存', 'saving');
      rememberEditorDraft();
      scheduleAutoSave();
    };
    const compareDate = (left, right) => String(left || '').localeCompare(String(right || ''));
    const compareText = (left, right) => String(left || '').localeCompare(String(right || ''), 'zh-CN');

    async function request(path, options) {
      const response = await fetch(`${apiBase}/${path}`, { cache: 'no-store', ...options });
      const data = await response.json();
      if (!response.ok) throw new Error((data.errors || [data.error || '请求失败']).join('；'));
      return data;
    }

    function rememberEditorSession() {
      if (!state.collectionId) return;
      const body = $('body');
      const snapshot = {
        collectionId: state.collectionId,
        selectedPath: state.selectedPath || derivedEntryPath(),
        selectionStart: body.selectionStart,
        selectionEnd: body.selectionEnd,
        scrollTop: body.scrollTop,
        previewScrollTop: $('preview').scrollTop,
        pageScrollTop: window.scrollY,
      };
      try { sessionStorage.setItem(EDITOR_SESSION_KEY, JSON.stringify(snapshot)); } catch { /* sessionStorage may be unavailable in a restricted browser context. */ }
    }

    function rememberEditorDraft() {
      if (!state.collectionId || !state.dirty) return;
      const body = $('body');
      const path = derivedEntryPath();
      if (!path) return;
      const snapshot = {
        version: 1,
        collectionId: state.collectionId,
        selectedPath: state.selectedPath || '',
        path,
        frontmatter: getFormValue(),
        body: body.value,
        selectionStart: body.selectionStart,
        selectionEnd: body.selectionEnd,
        scrollTop: body.scrollTop,
        previewScrollTop: $('preview').scrollTop,
        pageScrollTop: window.scrollY,
      };
      try { localStorage.setItem(EDITOR_DRAFT_KEY, JSON.stringify(snapshot)); } catch { /* localStorage may be unavailable or full. */ }
    }

    function readEditorDraft() {
      try {
        const raw = localStorage.getItem(EDITOR_DRAFT_KEY);
        if (!raw) return null;
        const snapshot = JSON.parse(raw);
        return snapshot && typeof snapshot === 'object' && snapshot.version === 1 ? snapshot : null;
      } catch { return null; }
    }

    function clearEditorDraft() {
      try { localStorage.removeItem(EDITOR_DRAFT_KEY); } catch { /* localStorage may be unavailable. */ }
    }

    function restoreEditorDraft(snapshot) {
      if (!snapshot || snapshot.collectionId !== state.collectionId || typeof snapshot.body !== 'string') return false;
      const path = String(snapshot.path || '').trim();
      if (!path) return false;
      const existingPath = snapshot.selectedPath || path;
      if (snapshot.selectedPath && !state.entries.some((entry) => entry.path === existingPath || entry.path === path)) return false;
      state.selectedPath = snapshot.selectedPath || '';
      setFormValue(snapshot.frontmatter || {}, snapshot.body, path);
      state.dirty = true;
      renderEntries();
      setStatus('已恢复未保存草稿', 'saving');
      scheduleAutoSave();
      return true;
    }

     function readEditorSession() {
      try {
        const raw = sessionStorage.getItem(EDITOR_SESSION_KEY);
        if (!raw) return null;
        const snapshot = JSON.parse(raw);
        return snapshot && typeof snapshot === 'object' ? snapshot : null;
      } catch { return null; }
     }

     function readImmersiveSession() {
       try { return sessionStorage.getItem(IMMERSIVE_SESSION_KEY) === 'true'; } catch { return false; }
     }

     function placeImmersiveToggle() {
       const button = $('immersive-toggle');
       const headingSlot = document.querySelector('.sidebar .panel-heading-actions');
       if (!button || !headingSlot) return;
       const wide = immersiveMedia.matches;
       const immersive = document.body.classList.contains('is-immersive');
       if (wide && !immersive) {
         $('save').insertAdjacentElement('beforebegin', button);
       } else if (button.parentElement !== headingSlot) {
         headingSlot.insertBefore(button, $('entry-count'));
       }
     }

     function setImmersiveMode(enabled, { focus = true, persist = true } = {}) {
       const button = $('immersive-toggle');
       const exitButton = $('immersive-exit');
       document.body.classList.toggle('is-immersive', enabled);
       button.setAttribute('aria-pressed', String(enabled));
       button.textContent = enabled ? '退出沉浸式编辑' : '沉浸式编辑';
       button.setAttribute('aria-label', enabled ? '退出沉浸式编辑' : '进入沉浸式编辑');
       button.title = enabled ? '退出沉浸式编辑（Esc）' : '进入沉浸式编辑';
       exitButton?.setAttribute('aria-pressed', String(enabled));
       exitButton?.setAttribute('aria-label', enabled ? '退出沉浸式编辑' : '进入沉浸式编辑');
       if (exitButton) exitButton.title = enabled ? '退出沉浸式编辑（Esc）' : '进入沉浸式编辑';
       if (persist) {
         try { sessionStorage.setItem(IMMERSIVE_SESSION_KEY, String(enabled)); } catch { /* sessionStorage may be unavailable. */ }
       }
       if (focus) (enabled ? $('body') : button).focus({ preventScroll: true });
       placeImmersiveToggle();
     }

    function closeEscapeLayers() {
      if (!$('delete-modal').hidden) {
        if (!deletePromise) closeDeleteModal();
        return true;
      }
      if (document.querySelector('.preview-lightbox')) return true;
       if (document.querySelector('.preview-footnote-popover.is-visible')) {
         activePreviewFootnoteClose?.();
         return true;
       }
       const hasPopover = !$('filter-popover').hidden || !$('sort-popover').hidden;
       const hasCustomSelect = document.querySelector('.custom-select.open');
       const hasMultiselect = document.querySelector('[data-multiselect] .multiselect-menu:not([hidden])');
       if (hasPopover) closePopovers();
       if (hasCustomSelect) closeCustomSelects();
       if (hasMultiselect) closeMultiselectMenus();
       return hasPopover || Boolean(hasCustomSelect) || Boolean(hasMultiselect);
     }

    function restoreEditorPosition(snapshot) {
      if (!snapshot) return;
      const body = $('body');
      const max = body.value.length;
      const start = Math.min(Math.max(Number(snapshot.selectionStart) || 0, 0), max);
      const end = Math.min(Math.max(Number(snapshot.selectionEnd) || start, start), max);
      body.focus({ preventScroll: true });
      body.setSelectionRange(start, end);
      body.scrollTop = Math.min(Math.max(Number(snapshot.scrollTop) || 0, 0), body.scrollHeight);
      if (snapshot.previewScrollTop != null || snapshot.pageScrollTop != null) {
        pendingScrollRestore = {
          previewTop: Math.max(Number(snapshot.previewScrollTop) || 0, 0),
          pageTop: Math.max(Number(snapshot.pageScrollTop) || 0, 0),
        };
      }
    }

    function restoreScrollPositions(previewTop, pageTop) {
      // Immersive mode scrolls inside #preview; normal mode grows with content and scrolls with the window, so compensate both owners.
      const preview = $('preview');
      let settled = false;
      const settle = () => {
        settled = true;
        window.removeEventListener('wheel', settle);
        window.removeEventListener('touchstart', settle);
      };
      const apply = () => {
        if (settled) return;
        preview.scrollTop = Math.min(previewTop, preview.scrollHeight);
        window.scrollTo(0, Math.min(pageTop, document.documentElement.scrollHeight));
      };
      window.addEventListener('wheel', settle, { passive: true });
      window.addEventListener('touchstart', settle, { passive: true });
      apply();
      // Images load asynchronously and stretch the content height, so keep compensating until they finish; stop as soon as the user scrolls manually.
      preview.querySelectorAll('img').forEach((img) => {
        if (img.complete) return;
        img.addEventListener('load', apply, { once: true });
        img.addEventListener('error', apply, { once: true });
      });
      window.setTimeout(settle, 3000);
    }

    function renderTabs() {
      $('collection-tabs').innerHTML = state.collections.map((item) => `<button class="tab${item.id === state.collectionId ? ' active' : ''}" data-collection="${escapeHtml(item.id)}" type="button" aria-selected="${item.id === state.collectionId}">${escapeHtml(item.label)}</button>`).join('');
      $('collection-tabs').querySelectorAll('.tab').forEach((button) => { button.onclick = () => switchCollection(button.dataset.collection); });
    }

    function fieldValue(entry, field) {
      const value = entry?.[field.id];
      if (Array.isArray(value)) return value.join('、');
      return value || '';
    }

    function updateFilterSummary() {
      const count = Object.values(state.filters).filter(Boolean).length;
      $('filter-summary').textContent = String(count);
      $('filter-hint').textContent = count ? `已启用 ${count} 项筛选` : '当前没有筛选条件';
      $('filter-toggle').classList.toggle('has-active', count > 0);
    }

    function renderSortOptions() {
      const current = SORT_OPTIONS.find((option) => option.value === state.sort) || SORT_OPTIONS[0];
      $('sort-toggle').title = `排序：${current.label}`;
      $('sort-toggle').setAttribute('aria-label', `排序：${current.label}`);
      $('sort-options').innerHTML = SORT_OPTIONS.map((option) => `<button class="sort-option${option.value === state.sort ? ' active' : ''}" data-sort="${option.value}" type="button">${option.label}</button>`).join('');
      $('sort-options').querySelectorAll('.sort-option').forEach((button) => {
        button.onclick = () => {
          state.sort = button.dataset.sort;
          renderSortOptions();
          renderEntries();
          closePopovers();
        };
      });
    }

    function closePopovers() {
      [['filter-popover', 'filter-toggle'], ['sort-popover', 'sort-toggle']].forEach(([popoverId, toggleId]) => {
        $(popoverId).hidden = true;
        $(toggleId).setAttribute('aria-expanded', 'false');
      });
    }

    function togglePopover(popoverId, toggleId) {
      const shouldOpen = $(popoverId).hidden;
      closePopovers();
      if (shouldOpen) {
        $(popoverId).hidden = false;
        $(toggleId).setAttribute('aria-expanded', 'true');
      }
    }

    function updateMultiselectLabel(fieldId) {
      const selected = [...document.querySelectorAll(`[data-field="${fieldId}"]:checked`)].map((input) => input.value);
      const label = $(`multiselect-label-${fieldId}`);
      if (!label) return;
      label.textContent = selected.length ? selected.join('、') : `请选择${activeCollection().fields.find((field) => field.id === fieldId)?.label || ''}`;
      label.classList.toggle('empty', selected.length === 0);
      document.querySelector(`[data-multiselect="${fieldId}"]`)?.querySelectorAll('.multiselect-option').forEach((option) => {
        option.classList.toggle('is-selected', option.querySelector('input')?.checked === true);
      });
    }

    function closeMultiselectMenus(exceptFieldId = '') {
      document.querySelectorAll('[data-multiselect]').forEach((control) => {
        if (control.dataset.multiselect === exceptFieldId) return;
        control.querySelector('.multiselect-menu').hidden = true;
        control.querySelector('.multiselect-trigger').setAttribute('aria-expanded', 'false');
      });
    }

    function bindMultiselect(fieldId) {
      const control = document.querySelector(`[data-multiselect="${fieldId}"]`);
      if (!control) return;
      const trigger = control.querySelector('.multiselect-trigger');
      const menu = control.querySelector('.multiselect-menu');
      trigger.onclick = (event) => {
        event.stopPropagation();
        const shouldOpen = menu.hidden;
        closeMultiselectMenus();
        menu.hidden = !shouldOpen;
        trigger.setAttribute('aria-expanded', String(shouldOpen));
      };
      menu.querySelectorAll('input[type="checkbox"]').forEach((input) => {
        input.onchange = () => updateMultiselectLabel(fieldId);
      });
      updateMultiselectLabel(fieldId);
    }

    function renderFilters() {
      const config = activeCollection();
      if (!config) return;
      const filterFields = config.fields.filter((field) => field.filterable);
      $('filter-fields').innerHTML = filterFields.map((field) => {
        const values = new Set();
        state.entries.forEach((entry) => {
          const value = entry[field.id];
          (Array.isArray(value) ? value : [value]).filter(Boolean).forEach((item) => values.add(String(item)));
        });
        const options = [...values].sort((left, right) => compareText(left, right));
        return `<label class="filter-field"><span>${escapeHtml(field.label)}</span><select data-filter="${escapeHtml(field.id)}"><option value="">全部</option>${options.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('')}</select></label>`;
      }).join('');
      $('filter-fields').querySelectorAll('select').forEach((select) => {
        select.value = state.filters[select.dataset.filter] || '';
        select.onchange = () => { state.filters[select.dataset.filter] = select.value; renderEntries(); };
      });
      updateFilterSummary();
    }

    function sortEntries(entries) {
      const sort = state.sort;
      return [...entries].sort((left, right) => {
        if (sort === 'title-desc') return compareText(right.title, left.title);
        if (sort === 'date-desc') return compareDate(right.date, left.date) || compareText(left.title, right.title);
        if (sort === 'title-asc') return compareText(left.title, right.title);
        return compareDate(right.updated || right.date, left.updated || left.date) || compareText(left.title, right.title);
      });
    }

    function renderEntries() {
      const query = $('search').value.trim().toLocaleLowerCase('zh-CN');
      const visible = sortEntries(state.entries.filter((entry) => {
        const searchable = [entry.title, entry.path, entry.description, entry.category, entry.subcategory, entry.subject, entry.site, entry.kind, ...(entry.technologies || []), ...(entry.categories || [])].filter(Boolean).join(' ').toLocaleLowerCase('zh-CN');
        if (query && !searchable.includes(query)) return false;
        return Object.entries(state.filters).every(([field, value]) => {
          if (!value) return true;
          const entryValue = entry[field];
          return Array.isArray(entryValue) ? entryValue.includes(value) : String(entryValue || '') === value;
        });
      }));
      $('entry-count').textContent = `共 ${visible.length} / ${state.entries.length} 篇`;
      $('entry-list').innerHTML = visible.map((entry) => {
        const meta = [entry.category || entry.site, entry.subcategory || entry.kind, entry.updated || entry.date].filter(Boolean).join(' · ');
        return `<button class="entry${entry.path === state.selectedPath ? ' active' : ''}" data-path="${encodeURIComponent(entry.path)}" type="button"><strong>${escapeHtml(entry.title || entry.path)}</strong><small>${escapeHtml(entry.path)}</small><span class="entry-meta"><span>${escapeHtml(meta)}</span></span></button>`;
      }).join('') || '<p class="empty">没有匹配内容。</p>';
      $('entry-list').querySelectorAll('.entry').forEach((button) => { button.onclick = () => loadEntry(decodeURIComponent(button.dataset.path)); });
      updateFilterSummary();
    }

    function customSelectRoot(id) {
      return document.querySelector(`[data-custom-select="${id}"]`);
    }

    function closeCustomSelects(except = null) {
      document.querySelectorAll('.custom-select.open').forEach((root) => {
        if (root === except) return;
        root.classList.remove('open');
        root.querySelector('.custom-select-menu').hidden = true;
        root.querySelector('.custom-select-trigger').setAttribute('aria-expanded', 'false');
      });
    }

    function syncCustomSelect(id) {
      const select = $(id);
      const root = customSelectRoot(id);
      if (!select || !root) return;
      const trigger = root.querySelector('.custom-select-trigger');
      const label = root.querySelector('.custom-select-label');
      const menu = root.querySelector('.custom-select-menu');
      const selected = [...select.options].find((option) => option.value === select.value) || select.options[0];
      label.textContent = selected?.textContent || '';
      trigger.disabled = select.disabled;
      if (select.disabled) {
        root.classList.remove('open');
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }
      menu.innerHTML = '';
      [...select.options].forEach((option) => {
        const item = document.createElement('button');
        item.className = `custom-select-option${option.value === select.value ? ' is-selected' : ''}`;
        item.type = 'button';
        item.setAttribute('role', 'option');
        item.setAttribute('aria-selected', String(option.value === select.value));
        item.textContent = option.textContent;
        item.onclick = (event) => {
          event.stopPropagation();
          if (select.disabled) return;
          select.value = option.value;
          syncCustomSelect(id);
          select.dispatchEvent(new Event('change', { bubbles: true }));
          closeCustomSelects();
        };
        menu.append(item);
      });
    }

    function initializeCustomSelects() {
      document.querySelectorAll('[data-custom-select]').forEach((root) => {
        const id = root.dataset.customSelect;
        const select = $(id);
        const trigger = root.querySelector('.custom-select-trigger');
        const menu = root.querySelector('.custom-select-menu');
        trigger.onclick = (event) => {
          event.stopPropagation();
          if (select.disabled) return;
          const shouldOpen = menu.hidden;
          closeCustomSelects(root);
          menu.hidden = !shouldOpen;
          root.classList.toggle('open', shouldOpen);
          trigger.setAttribute('aria-expanded', String(shouldOpen));
        };
        menu.onclick = (event) => event.stopPropagation();
        syncCustomSelect(id);
      });
    }

    function refreshDependentSelect(select, preferredValue = '') {
      if (!select?.dataset.optionGroups) return;
      const parent = $(`field-${select.dataset.dependsOn}`);
      if (!parent) return;
      let optionGroups = {};
      try { optionGroups = JSON.parse(select.dataset.optionGroups); } catch { return; }
      const options = optionGroups[parent.value] || [];
      const currentValue = preferredValue || select.value;
      select.innerHTML = options.map((option) => `<option value="${escapeHtml(option)}">${escapeHtml(option)}</option>`).join('');
      select.value = options.includes(currentValue) ? currentValue : (options[0] || '');
      syncCustomSelect(select.id);
    }

    function bindDependentSelects() {
      document.querySelectorAll('select[data-dependent-select]').forEach((select) => {
        const parent = $(`field-${select.dataset.dependsOn}`);
        if (!parent) return;
        parent.onchange = () => { refreshDependentSelect(select); markDirty(); };
        refreshDependentSelect(select);
      });
    }

    function fieldControl(field) {
      const required = field.required ? ' <span class="required">*</span>' : '';
      const requiredAttribute = field.required ? ' required' : '';
      const ariaRequired = field.required ? ' aria-required="true"' : '';
      const readonlyAttribute = field.readonly ? ' readonly aria-readonly="true"' : '';
      if (field.type === 'multiselect') {
        const menuId = `multiselect-menu-${field.id}`;
        return `<div class="field"><span>${escapeHtml(field.label)}${required}</span><div class="multiselect-control" data-multiselect="${escapeHtml(field.id)}"><button class="multiselect-trigger" id="multiselect-trigger-${escapeHtml(field.id)}" type="button" aria-expanded="false" aria-controls="${menuId}"${ariaRequired}><span class="multiselect-label empty" id="multiselect-label-${escapeHtml(field.id)}">请选择${escapeHtml(field.label)}</span><span class="multiselect-chevron" aria-hidden="true">⌄</span></button><div class="multiselect-menu" id="${menuId}" hidden>${field.options.map((option) => `<label class="multiselect-option"><input type="checkbox" data-field="${escapeHtml(field.id)}" value="${escapeHtml(option)}"><span>${escapeHtml(option)}</span></label>`).join('')}</div></div></div>`;
      }
      if (field.type === 'links') {
        return `<div class="field wide"><span>${escapeHtml(field.label)}${required}</span><div class="links-list" id="links-${escapeHtml(field.id)}"></div><button class="add-link" data-add-links="${escapeHtml(field.id)}" type="button">＋ 添加链接</button></div>`;
      }
      if (field.type === 'select') {
        const selectId = `field-${field.id}`;
        const dependent = field.dependsOn ? ` data-dependent-select="true" data-depends-on="${escapeHtml(field.dependsOn)}" data-option-groups="${escapeHtml(JSON.stringify(field.optionsBy || {}))}"` : '';
        return `<label class="field"><span>${escapeHtml(field.label)}${required}</span><div class="custom-select" data-custom-select="${selectId}"><select class="custom-select-native" id="${selectId}"${dependent}${requiredAttribute}${ariaRequired} aria-hidden="true" tabindex="-1">${field.options.map((option) => `<option value="${escapeHtml(option)}">${escapeHtml(option)}</option>`).join('')}</select><button class="custom-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="${escapeHtml(field.label)}"${ariaRequired}><span class="custom-select-label">${escapeHtml(field.options[0] || '')}</span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" /></svg></button><div class="custom-select-menu" role="listbox" hidden></div></div></label>`;
      }
      const tag = field.type === 'textarea' || field.type === 'tags' ? 'textarea' : 'input';
      const type = field.type === 'date' ? ' type="date"' : '';
      const placeholder = field.type === 'tags' ? '每行一个，或用逗号分隔' : '';
      const autocomplete = tag === 'input' ? ' autocomplete="off"' : '';
      return `<label class="field${field.type === 'textarea' || field.type === 'tags' ? ' wide' : ''}"><span>${escapeHtml(field.label)}${required}</span><${tag} id="field-${escapeHtml(field.id)}"${type}${autocomplete}${requiredAttribute}${ariaRequired}${readonlyAttribute} placeholder="${placeholder}"></${tag}></label>`;
    }

    function renderMetadata() {
      const config = activeCollection();
      if (!config) return;
      const groups = [...new Set(config.fields.map((field) => field.section || '内容信息'))];
      const pathSection = groups.includes('文件与发布') ? '文件与发布' : groups[groups.length - 1];
      const groupMarkup = groups.map((section) => {
        const pathMarkup = section === pathSection
          ? (managedPathStrategy(config)
            ? `<div class="path-row field"><span>文件路径（由一级、二级分类和标题自动生成）</span><input id="entry-path" readonly aria-readonly="true"></div>`
            : `<div class="path-row field"><span>文件路径（相对于 src/content/${escapeHtml(config.root)}/）</span><input id="entry-path" autocomplete="off" placeholder="${escapeHtml(config.defaultPath)}"></div>`)
          : '';
        const description = config.sectionDescriptions?.[section] || config.description;
        return `<section class="metadata-group"><h3>${escapeHtml(section)}</h3><p>${escapeHtml(description)}</p>${pathMarkup}<div class="metadata-grid">${config.fields.filter((field) => (field.section || '内容信息') === section).map(fieldControl).join('')}</div></section>`;
      }).join('');
      $('metadata').innerHTML = `<div class="metadata-groups">${groupMarkup}</div>`;
      initializeCustomSelects();
      $('metadata').querySelectorAll('[data-multiselect]').forEach((control) => { bindMultiselect(control.dataset.multiselect); });
      bindDependentSelects();
      $('metadata').querySelectorAll('[data-add-links]').forEach((button) => { button.onclick = () => addLinkRow(button.dataset.addLinks); });
      $('metadata').oninput = markDirty;
      $('metadata').onchange = markDirty;
      const strategy = managedPathStrategy(config);
      if (strategy) {
        [`field-${strategy.categoryField}`, `field-${strategy.subcategoryField}`].forEach((id) => {
          $(id)?.addEventListener('change', updateDerivedEntryPath);
        });
        $('field-title').addEventListener('input', updateDerivedEntryPath);
      }
    }

    function addLinkRow(fieldId, value = {}) {
      const list = $(`links-${fieldId}`);
      const row = document.createElement('div');
      row.className = 'link-row';
      row.innerHTML = `<input class="link-title" autocomplete="off" placeholder="链接标题" value="${escapeHtml(value.title || '')}"><input class="link-url" autocomplete="off" placeholder="https://…" value="${escapeHtml(value.url || '')}"><button class="remove-link" type="button" aria-label="删除链接">×</button>`;
      row.querySelector('.remove-link').onclick = () => { row.remove(); markDirty(); };
      row.querySelectorAll('input').forEach((input) => { input.oninput = markDirty; });
      list.append(row);
    }

    function setFormValue(frontmatter = {}, body = '', entryPath = '') {
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = 0;
      state.draftVersion += 1;
      const strategy = managedPathStrategy();
      if (!strategy) $('entry-path').value = entryPath;
      activeCollection().fields.forEach((field) => {
        const value = frontmatter[field.id];
        if (field.type === 'multiselect') {
          document.querySelectorAll(`[data-field="${field.id}"]`).forEach((input) => { input.checked = Array.isArray(value) && value.includes(input.value); });
        } else if (field.type === 'links') {
          $(`links-${field.id}`).innerHTML = '';
          (Array.isArray(value) ? value : []).forEach((link) => addLinkRow(field.id, link));
        } else if ($(`field-${field.id}`)) {
          $(`field-${field.id}`).value = Array.isArray(value) ? value.join('\n') : (value ?? '');
        }
      });
      activeCollection().fields.filter((field) => field.dependsOn).forEach((field) => refreshDependentSelect($(`field-${field.id}`), frontmatter[field.id] || ''));
      activeCollection().fields.filter((field) => field.type === 'select').forEach((field) => syncCustomSelect(`field-${field.id}`));
      activeCollection().fields.filter((field) => field.type === 'multiselect').forEach((field) => updateMultiselectLabel(field.id));
      if (strategy) updateDerivedEntryPath();
      $('body').value = body || '';
      resetEditorHistory();
      selectedPreviewNode = null;
      selectedPreviewSourceRange = null;
      updateBodyMeta();
      schedulePreview();
      updateDeleteButton();
    }

    function updateDeleteButton() {
      const button = $('delete');
      if (!button) return;
      const canDelete = Boolean(state.selectedPath);
      button.disabled = !canDelete || Boolean(deletePromise);
      button.title = canDelete ? '将当前文章移入废纸篓' : '新文章尚未保存';
    }

    function setDeleteModalBusy(busy) {
      $('delete-modal-confirm').disabled = busy;
      $('delete-modal-cancel').disabled = busy;
      $('delete-modal-close').disabled = busy;
      $('delete-modal-confirm').textContent = busy ? '删除中…' : '删除';
    }

    function openDeleteModal() {
      if (!state.selectedPath || deletePromise) return;
      const title = $('field-title')?.value.trim() || state.selectedPath;
      $('delete-modal-message').textContent = `确定要将“${title}”移入废纸篓吗？Markdown 文件仍可从废纸篓恢复。`;
      deleteReturnFocus = document.activeElement;
      $('delete-modal').hidden = false;
      $('delete-modal').setAttribute('aria-hidden', 'false');
      window.requestAnimationFrame(() => $('delete-modal-cancel').focus());
    }

    function closeDeleteModal({ restoreFocus = true } = {}) {
      const modal = $('delete-modal');
      if (modal.hidden) return;
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      const returnFocus = deleteReturnFocus;
      deleteReturnFocus = null;
      if (restoreFocus && returnFocus instanceof HTMLElement && returnFocus.isConnected) returnFocus.focus({ preventScroll: true });
    }

    async function deleteCurrentEntry() {
      if (!state.selectedPath || deletePromise) return false;
      setDeleteModalBusy(true);
      const collectionId = state.collectionId;
      const promise = (async () => {
        try {
          if (state.dirty && !(await flushAutoSave())) {
            setStatus('自动保存失败，未删除', 'error');
            return false;
          }
          const entryPath = state.selectedPath;
          if (!entryPath) return false;
          await request(`entry?collection=${encodeURIComponent(collectionId)}&path=${encodeURIComponent(entryPath)}`, { method: 'DELETE' });
          state.selectedPath = '';
          state.dirty = false;
          if (state.collectionId === collectionId) {
            try { await loadEntries(); } catch { /* The file is already in the Trash even if the list refresh fails. */ }
            const config = activeCollection();
            const frontmatter = clone(config.defaultFrontmatter);
            frontmatter.date = today();
            frontmatter.updated = today();
            setFormValue(frontmatter, '', config.defaultPath);
            renderEntries();
          }
          closeDeleteModal({ restoreFocus: false });
          setStatus('已移入废纸篓', 'saved');
          $('field-title')?.focus();
          return true;
        } catch (error) {
          setStatus(error.message, 'error');
          return false;
        } finally {
          setDeleteModalBusy(false);
        }
      })();
      deletePromise = promise;
      try { return await promise; }
      finally {
        if (deletePromise === promise) {
          deletePromise = null;
          updateDeleteButton();
        }
      }
    }

    function getFormValue() {
      const result = {};
      activeCollection().fields.forEach((field) => {
        if (field.type === 'multiselect') result[field.id] = [...document.querySelectorAll(`[data-field="${field.id}"]:checked`)].map((input) => input.value);
        else if (field.type === 'links') result[field.id] = [...$(`links-${field.id}`).querySelectorAll('.link-row')].map((row) => ({ title: row.querySelector('.link-title').value.trim(), url: row.querySelector('.link-url').value.trim() }));
        else if (field.type === 'tags') result[field.id] = $(`field-${field.id}`).value.split(/[\n,]/).map((value) => value.trim()).filter(Boolean);
        else result[field.id] = $(`field-${field.id}`).value;
      });
      return result;
    }

    async function flushAutoSave() {
      while (state.dirty) {
        const saved = await saveEntry();
        if (!saved) return false;
      }
      return true;
    }

    async function ensureEditorSaved() {
      if (!state.dirty) return true;
      if (await flushAutoSave()) return true;
      return window.confirm('自动保存失败，仍要切换吗？');
    }

    function updateBodyMeta() {
      $('body-meta').textContent = `${$('body').value.length} 字符`;
      if (editorState && !isProgrammaticEdit) editorState = getEditorState();
    }
    function getEditorState() {
      const body = $('body');
      return { value: body.value, selectionStart: body.selectionStart, selectionEnd: body.selectionEnd };
    }
    function sameEditorValue(left, right) {
      return left?.value === right?.value;
    }
    function pushUndo(state) {
      if (!state || sameEditorValue(undoStack.at(-1), state)) return;
      undoStack.push(state);
      if (undoStack.length > editorHistoryLimit) undoStack.shift();
      redoStack = [];
    }
    function resetEditorHistory() {
      editorState = getEditorState();
      undoStack = [];
      redoStack = [];
    }
    function runEditorEdit(edit) {
      const previous = editorState || getEditorState();
      isProgrammaticEdit = true;
      try {
        edit();
      } finally {
        isProgrammaticEdit = false;
      }
      const next = getEditorState();
      if (!sameEditorValue(previous, next)) pushUndo(previous);
      editorState = next;
      handleBodyChange();
    }
    function restoreEditorState(state) {
      const body = $('body');
      isProgrammaticEdit = true;
      body.value = state.value;
      body.focus();
      const max = body.value.length;
      body.setSelectionRange(Math.min(state.selectionStart, max), Math.min(state.selectionEnd, max));
      isProgrammaticEdit = false;
      editorState = getEditorState();
      handleBodyChange();
    }
    function undoEditor() {
      if (!undoStack.length) return;
      const current = editorState || getEditorState();
      const previous = undoStack.pop();
      redoStack.push(current);
      restoreEditorState(previous);
    }
    function redoEditor() {
      if (!redoStack.length) return;
      const current = editorState || getEditorState();
      const next = redoStack.pop();
      undoStack.push(current);
      restoreEditorState(next);
    }
    function handleHistoryShortcut(event) {
      const active = document.activeElement;
      const inMarkdownEditor = active === $('body') || active?.classList.contains('editor-tool');
      if (!inMarkdownEditor || (!event.metaKey && !event.ctrlKey) || event.altKey) return;
      const key = event.key.toLowerCase();
      const undo = key === 'z' && !event.shiftKey;
      const redo = (key === 'z' && event.shiftKey) || (key === 'y' && !event.shiftKey);
      if (!undo && !redo) return;
      event.preventDefault();
      if (undo) undoEditor();
      if (redo) redoEditor();
    }
    function handleBodyChange() {
      schedulePreview();
      updateBodyMeta();
      markDirty();
    }
    function handleBodyInput() {
      if (isProgrammaticEdit) return;
      const next = getEditorState();
      if (!sameEditorValue(editorState, next)) pushUndo(editorState);
      editorState = next;
      handleBodyChange();
    }

    function indentBodySelection() {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const indent = '  ';
      if (start === end) {
        body.setRangeText(indent, start, end, 'end');
      } else {
        const value = body.value;
        const lineStart = value.lastIndexOf('\n', start - 1) + 1;
        const selectionEndsAtLineStart = value[end - 1] === '\n';
        const lineEnd = selectionEndsAtLineStart ? end : (value.indexOf('\n', end) === -1 ? value.length : value.indexOf('\n', end));
        const lines = value.slice(lineStart, lineEnd).split('\n');
        body.setRangeText(lines.map((line) => `${indent}${line}`).join('\n'), lineStart, lineEnd, 'select');
        body.setSelectionRange(start + indent.length, end + indent.length * lines.length);
      }
      body.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function outdentBodySelection() {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const value = body.value;
      const lineStart = value.lastIndexOf('\n', start - 1) + 1;
      const selectionEndsAtLineStart = value[end - 1] === '\n';
      const lineEnd = selectionEndsAtLineStart ? end : (value.indexOf('\n', end) === -1 ? value.length : value.indexOf('\n', end));
      const lines = value.slice(lineStart, lineEnd).split('\n');
      const removed = lines.map((line) => (line.match(/^(?:\t| {1,2})/) || [''])[0].length);
      if (!removed.some((count) => count > 0)) return;
      body.setRangeText(lines.map((line) => line.replace(/^(?:\t| {1,2})/, '')).join('\n'), lineStart, lineEnd, 'select');
      const totalRemoved = removed.reduce((sum, count) => sum + count, 0);
      body.setSelectionRange(Math.max(lineStart, start - removed[0]), Math.max(lineStart, end - totalRemoved));
      body.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function handleBodyKeydown(event) {
      if (event.key === 'Tab') {
        event.preventDefault();
        if (event.shiftKey) outdentBodySelection();
        else indentBodySelection();
        return;
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        event.stopPropagation();
        void saveEntry({ force: true });
      }
    }

    async function loadEntries() {
      const data = await request(`entries?collection=${encodeURIComponent(state.collectionId)}`);
      state.entries = data.entries;
      renderFilters();
      renderEntries();
    }

    async function loadEntry(entryPath) {
      if (!(await ensureEditorSaved())) return;
      try {
        const data = await request(`entry?collection=${encodeURIComponent(state.collectionId)}&path=${encodeURIComponent(entryPath)}`);
        state.selectedPath = entryPath;
        state.dirty = false;
        setFormValue(data.frontmatter, data.body, data.path);
        renderEntries();
        setStatus('已读取', 'saved');
      } catch (error) { setStatus(error.message, 'error'); }
    }

    async function createNew() {
      if (!(await ensureEditorSaved())) return;
      const config = activeCollection();
      const frontmatter = clone(config.defaultFrontmatter);
      frontmatter.date = today();
      frontmatter.updated = today();
      state.selectedPath = '';
      state.dirty = false;
      setFormValue(frontmatter, '', config.defaultPath);
      renderEntries();
      setStatus('新建模式');
      $('field-title')?.focus();
    }

    async function saveEntry({ force = false } = {}) {
      if (savePromise) return savePromise;
      if (!state.dirty && !force) return true;
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = 0;
      rememberEditorSession();
      const collectionId = state.collectionId;
      const draftVersion = state.draftVersion;
      const path = derivedEntryPath();
      const previousPath = state.selectedPath;
      const frontmatter = getFormValue();
      const body = $('body').value;
      $('save').disabled = true;
      setStatus('自动保存中…', 'saving');
      const promise = (async () => {
        try {
          const data = await request('entry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ collection: collectionId, path, previousPath, frontmatter, body }) });
          const isCurrentDraft = state.collectionId === collectionId && state.draftVersion === draftVersion;
          if (isCurrentDraft) {
            state.dirty = false;
            state.selectedPath = data.path;
            const updatedField = $('field-updated');
            if (data.frontmatter?.updated && updatedField) updatedField.value = data.frontmatter.updated;
            clearEditorDraft();
            updateDeleteButton();
            setStatus('已自动保存 · 刚刚', 'saved');
          }
          if (state.collectionId === collectionId) {
            try { await loadEntries(); } catch { /* The content is saved even if the list refresh fails. */ }
          }
          if (!isCurrentDraft) {
            setStatus('等待自动保存', 'saving');
            scheduleAutoSave();
          }
          return true;
        } catch (error) {
          setStatus(error.message, 'error');
          return false;
        } finally { $('save').disabled = false; }
      })();
      savePromise = promise;
      try { return await promise; }
      finally { if (savePromise === promise) savePromise = null; }
    }

    function schedulePreview() {
      window.clearTimeout(previewTimer);
      previewTimer = window.setTimeout(async () => {
        const requestId = ++state.previewId;
        const body = $('body').value;
        if (!body.trim()) {
          previewFootnoteCleanup();
          $('preview').innerHTML = '<p class="preview-placeholder">Markdown 预览会显示在这里</p>';
          selectedPreviewNode = null;
          selectedPreviewSourceRange = null;
          pendingScrollRestore = null;
          $('preview').classList.remove('is-loading');
          return;
        }
        previewFootnoteCleanup();
        $('preview').classList.add('is-loading');
        try {
          const data = await request('preview', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ collection: state.collectionId, body }) });
          if (requestId === state.previewId) {
            $('preview').innerHTML = data.html || '<p class="preview-placeholder">暂无预览</p>';
            enhancePreviewImages();
            enhancePreviewFootnotes();
            selectedPreviewNode = null;
            selectedPreviewSourceRange = null;
            if (pendingScrollRestore) {
              const { previewTop, pageTop } = pendingScrollRestore;
              pendingScrollRestore = null;
              restoreScrollPositions(previewTop, pageTop);
            }
          }
        } catch (error) {
          if (requestId === state.previewId) {
            $('preview').innerHTML = `<p class="preview-placeholder">预览失败：${escapeHtml(error.message)}</p>`;
            selectedPreviewNode = null;
            selectedPreviewSourceRange = null;
          }
        } finally {
          if (requestId === state.previewId) $('preview').classList.remove('is-loading');
        }
      }, 180);
    }

    function enhancePreviewImages(root = $('preview')) {
      root.querySelectorAll('img').forEach((img) => {
        if (img.closest('a')) return;
        img.setAttribute('tabindex', '0');
        img.setAttribute('role', 'button');
        img.setAttribute('aria-label', '查看大图');
      });
    }

    function openPreviewLightbox(trigger, src, alt) {
      const overlay = document.createElement('div');
      overlay.className = 'preview-lightbox';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', '图片预览');

      const content = document.createElement('div');
      content.className = 'preview-lightbox-content';

      const preview = document.createElement('img');
      preview.src = src;
      preview.alt = alt || '图片预览';
      preview.decoding = 'async';

      const closeButton = document.createElement('button');
      closeButton.type = 'button';
      closeButton.className = 'preview-lightbox-close';
      closeButton.setAttribute('aria-label', '关闭大图');
      closeButton.textContent = '×';

      const closeLightbox = () => {
        overlay.remove();
        document.removeEventListener('keydown', handleEscape);
        trigger.focus({ preventScroll: true });
      };
      const handleEscape = (event) => {
        if (event.key === 'Escape') closeLightbox();
      };

      content.append(preview, closeButton);
      overlay.append(content);
      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) closeLightbox();
      });
      closeButton.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', handleEscape);
      document.body.appendChild(overlay);
      closeButton.focus();
    }

    function enhancePreviewFootnotes() {
      previewFootnoteCleanup();
      const preview = $('preview');
      const templates = new Map(
        Array.from(preview.querySelectorAll('template[data-article-popover-content]'))
          .map((template) => [template.dataset.articlePopoverContent, template]),
      );
      const cleanups = [];

      preview.querySelectorAll('[data-article-popover-trigger]').forEach((trigger, index) => {
        const id = trigger.dataset.articlePopoverTrigger;
        const template = templates.get(id);
        if (!template) return;

        const panel = document.createElement('div');
        panel.className = 'preview-footnote-popover';
        panel.id = `preview-footnote-${state.previewId}-${index}`;
        panel.setAttribute('role', 'dialog');
        panel.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-controls', panel.id);

        const content = document.createElement('div');
        content.className = 'preview-footnote-popover-content';
        content.innerHTML = template.innerHTML;
        panel.dataset.popoverKind = content.querySelector('table') ? 'table' : 'note';

        const heading = document.createElement('div');
        heading.className = 'preview-footnote-popover-heading';
        const title = document.createElement('span');
        title.className = 'preview-footnote-popover-title';
        title.textContent = trigger.textContent.trim();
        heading.append(title);
        panel.append(heading, content);
        document.body.appendChild(panel);

        let pinned = false;
        let hideTimer = 0;
        const padding = 16;
        const gap = 10;
        const cancelHide = () => {
          if (!hideTimer) return;
          window.clearTimeout(hideTimer);
          hideTimer = 0;
        };
        const close = () => {
          cancelHide();
          pinned = false;
          panel.classList.remove('is-visible');
          panel.setAttribute('aria-hidden', 'true');
          trigger.setAttribute('aria-expanded', 'false');
          if (activePreviewFootnoteClose === close) activePreviewFootnoteClose = null;
        };
        const scheduleHide = () => {
          cancelHide();
          hideTimer = window.setTimeout(() => {
            if (!pinned) close();
          }, 160);
        };
        const position = () => {
          if (!panel.classList.contains('is-visible')) return;
          const triggerRect = trigger.getBoundingClientRect();
          const panelRect = panel.getBoundingClientRect();
          const left = Math.min(
            Math.max(triggerRect.left, padding),
            Math.max(padding, window.innerWidth - panelRect.width - padding),
          );
          const topSpace = Math.max(0, triggerRect.top - padding - gap);
          const bottomSpace = Math.max(0, window.innerHeight - triggerRect.bottom - padding - gap);
          const fitsTop = panelRect.height <= topSpace;
          const fitsBottom = panelRect.height <= bottomSpace;
          const placement = fitsBottom || (!fitsTop && bottomSpace >= topSpace) ? 'bottom' : 'top';
          const availableSpace = placement === 'bottom' ? bottomSpace : topSpace;
          const contentRect = content.getBoundingClientRect();
          const panelChrome = panelRect.height - contentRect.height;
          const maxContentHeight = Math.min(window.innerHeight * .7, 560);
          const availableContentHeight = Math.max(120, availableSpace - panelChrome);
          content.style.maxHeight = `${Math.min(maxContentHeight, availableContentHeight)}px`;

          const positionedPanelRect = panel.getBoundingClientRect();
          const preferredTop = placement === 'bottom'
            ? triggerRect.bottom + gap
            : triggerRect.top - positionedPanelRect.height - gap;
          const top = Math.max(
            padding,
            Math.min(preferredTop, window.innerHeight - padding - positionedPanelRect.height),
          );
          const arrowLeft = Math.min(
            Math.max(triggerRect.left + triggerRect.width / 2 - left, 22),
            Math.max(22, positionedPanelRect.width - 22),
          );
          panel.style.left = `${left}px`;
          panel.style.top = `${top}px`;
          panel.dataset.placement = placement;
          panel.style.setProperty('--popover-arrow-left', `${arrowLeft}px`);
        };
        const show = () => {
          cancelHide();
          if (activePreviewFootnoteClose && activePreviewFootnoteClose !== close) activePreviewFootnoteClose();
          activePreviewFootnoteClose = close;
          panel.classList.add('is-visible');
          panel.setAttribute('aria-hidden', 'false');
          trigger.setAttribute('aria-expanded', 'true');
          window.requestAnimationFrame(position);
        };
        const handleTriggerKeydown = (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          trigger.click();
        };
        const handleTriggerClick = (event) => {
          event.preventDefault();
          pinned = !pinned;
          if (pinned) show();
          else close();
        };
        const handleEscape = (event) => {
          if (event.key === 'Escape') close();
        };
        const handlePanelClick = (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const image = target?.closest('img');
          if (!image || !panel.contains(image) || image.closest('a')) return;
          event.preventDefault();
          openPreviewLightbox(image, image.currentSrc || image.src, image.alt);
        };
        const handlePanelKeydown = (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          const target = event.target instanceof Element ? event.target : null;
          const image = target?.closest('img');
          if (!image || !panel.contains(image) || image.closest('a')) return;
          event.preventDefault();
          openPreviewLightbox(image, image.currentSrc || image.src, image.alt);
        };

        trigger.addEventListener('mouseenter', show);
        trigger.addEventListener('mouseleave', scheduleHide);
        trigger.addEventListener('focus', show);
        trigger.addEventListener('blur', scheduleHide);
        trigger.addEventListener('keydown', handleTriggerKeydown);
        trigger.addEventListener('click', handleTriggerClick);
        panel.addEventListener('mouseenter', cancelHide);
        panel.addEventListener('mouseleave', scheduleHide);
        panel.addEventListener('click', handlePanelClick);
        panel.addEventListener('keydown', handlePanelKeydown);
        window.addEventListener('resize', position);
        preview.addEventListener('scroll', position, { passive: true });
        document.addEventListener('keydown', handleEscape);
        enhancePreviewImages(panel);

        cleanups.push(() => {
          trigger.removeEventListener('mouseenter', show);
          trigger.removeEventListener('mouseleave', scheduleHide);
          trigger.removeEventListener('focus', show);
          trigger.removeEventListener('blur', scheduleHide);
          trigger.removeEventListener('keydown', handleTriggerKeydown);
          trigger.removeEventListener('click', handleTriggerClick);
          panel.removeEventListener('mouseenter', cancelHide);
          panel.removeEventListener('mouseleave', scheduleHide);
          panel.removeEventListener('click', handlePanelClick);
          panel.removeEventListener('keydown', handlePanelKeydown);
          window.removeEventListener('resize', position);
          preview.removeEventListener('scroll', position);
          document.removeEventListener('keydown', handleEscape);
          close();
          panel.remove();
        });
      });

      previewFootnoteCleanup = () => {
        cleanups.splice(0).forEach((cleanup) => cleanup());
        previewFootnoteCleanup = () => {};
      };
    }

    const previewBlockSelector = 'h1[data-source-start], h2[data-source-start], h3[data-source-start], h4[data-source-start], h5[data-source-start], h6[data-source-start], p[data-source-start], ul[data-source-start], ol[data-source-start], blockquote[data-source-start], pre[data-source-start], table[data-source-start], li[data-source-start], hr[data-source-start], figure[data-source-start], dl[data-source-start], .katex-display[data-source-start]';
    function findPreviewBlock(node) {
      const element = node?.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement;
      const block = element?.closest?.(previewBlockSelector);
      return block && $('preview').contains(block) ? block : null;
    }
    function sourceLineOffset(line, end = false) {
      const source = $('body').value;
      if (line <= 1) return end ? (source.indexOf('\n') === -1 ? source.length : source.indexOf('\n')) : 0;
      let offset = 0;
      for (let current = 1; current < line; current += 1) {
        const newline = source.indexOf('\n', offset);
        if (newline === -1) return source.length;
        offset = newline + 1;
      }
      if (!end) return offset;
      const newline = source.indexOf('\n', offset);
      return newline === -1 ? source.length : newline;
    }
    function previewRange(node) {
      const startLine = Number(node?.dataset.sourceStart);
      const endLine = Number(node?.dataset.sourceEnd);
      if (!startLine || !endLine) return null;
      return { start: sourceLineOffset(startLine), end: sourceLineOffset(endLine, true), startLine, endLine };
    }
    function capturePreviewSelection() {
      const preview = $('preview');
      const selection = window.getSelection();
      if (!selection?.rangeCount || selection.isCollapsed || !preview.contains(selection.anchorNode) || !preview.contains(selection.focusNode)) return;
      const nodes = [findPreviewBlock(selection.anchorNode), findPreviewBlock(selection.focusNode)].filter(Boolean);
      const ranges = nodes.map(previewRange).filter(Boolean);
      if (!ranges.length) return;
      selectedPreviewNode = nodes[0];
      selectedPreviewSourceRange = {
        start: Math.min(...ranges.map((range) => range.start)),
        end: Math.max(...ranges.map((range) => range.end)),
        startLine: Math.min(...ranges.map((range) => range.startLine)),
        endLine: Math.max(...ranges.map((range) => range.endLine)),
      };
    }
    function previewBlocks() {
      return Array.from($('preview').querySelectorAll(previewBlockSelector));
    }
    function previewBlockPosition(node) {
      const preview = $('preview');
      const previewRect = preview.getBoundingClientRect();
      const rect = node.getBoundingClientRect();
      return {
        top: rect.top - previewRect.top + preview.scrollTop,
        bottom: rect.bottom - previewRect.top + preview.scrollTop,
      };
    }
    function findPreviewBlockForScrollPosition() {
      const preview = $('preview');
      const targetPosition = preview.scrollTop + Math.min(72, preview.clientHeight * 0.32);
      const candidates = previewBlocks()
        .map((node) => ({ node, range: previewRange(node), position: previewBlockPosition(node) }))
        .filter((item) => item.range);
      const containing = candidates
        .filter((item) => item.position.top <= targetPosition && item.position.bottom >= targetPosition)
        .sort((left, right) => {
          const lineSpan = (item) => item.range.endLine - item.range.startLine;
          return lineSpan(left) - lineSpan(right);
        });
      if (containing[0]) return containing[0].node;
      return candidates
        .sort((left, right) => Math.abs(left.position.top - targetPosition) - Math.abs(right.position.top - targetPosition))[0]?.node || null;
    }
    function findPreviewBlockForLine(line) {
      const blocks = previewBlocks();
      const containing = blocks
        .filter((node) => {
          const range = previewRange(node);
          return range && range.startLine <= line && range.endLine >= line;
        })
        .sort((left, right) => {
          const leftRange = previewRange(left);
          const rightRange = previewRange(right);
          return (leftRange.endLine - leftRange.startLine) - (rightRange.endLine - rightRange.startLine);
        });
      if (containing[0]) return containing[0];
      return blocks
        .map((node) => ({ node, range: previewRange(node) }))
        .filter((item) => item.range)
        .sort((left, right) => Math.abs(left.range.startLine - line) - Math.abs(right.range.startLine - line))[0]?.node || null;
    }
    function highlightPreviewBlock(node) {
      if (!node) return;
      $('preview').querySelectorAll('.is-sync-target').forEach((target) => target.classList.remove('is-sync-target'));
      node.classList.add('is-sync-target');
      selectedPreviewNode = node;
      node.scrollIntoView({ behavior: 'smooth', block: 'center' });
      window.clearTimeout(syncHighlightTimer);
      syncHighlightTimer = window.setTimeout(() => node.classList.remove('is-sync-target'), 1400);
    }
    function syncSourceToPreview() {
      const source = $('body').value;
      const line = source.slice(0, $('body').selectionStart).split('\n').length;
      const target = findPreviewBlockForLine(line);
      if (!target) return setStatus('当前内容没有可定位的预览区域');
      highlightPreviewBlock(target);
    }
    function syncPreviewToSource() {
      const selection = window.getSelection();
      const selectionNode = selection?.rangeCount
        ? [selection.anchorNode, selection.focusNode]
          .filter((node) => $('preview').contains(node))
          .map(findPreviewBlock)
          .find(Boolean)
        : null;
      const target = [selectionNode, selectedPreviewNode, findPreviewBlockForScrollPosition()]
        .find((node) => previewRange(node));
      const range = selectionNode ? previewRange(selectionNode) : (selectedPreviewSourceRange || previewRange(target));
      if (!target || !range) return setStatus('当前预览没有可定位的内容');
      const body = $('body');
      body.focus();
      body.setSelectionRange(range.start, range.end);
      const lineHeight = Number.parseFloat(getComputedStyle(body).lineHeight) || 21;
      body.scrollTop = Math.max(0, (range.startLine - 1) * lineHeight - body.clientHeight / 2);
      updateBodyMeta();
    }

    function replaceSelection(before, after = '', placeholder = '') {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const selected = body.value.slice(start, end) || placeholder;
      runEditorEdit(() => {
        body.focus();
        body.setRangeText(before + selected + after, start, end, 'select');
      });
    }
    function isWrapped(value, before, after) {
      if (value.length < before.length + after.length || !value.startsWith(before) || !value.endsWith(after)) return false;
      if (before === '*' && after === '*' && (value.startsWith('**') || value.endsWith('**'))) return false;
      return true;
    }
    function toggleWrap(before, after, placeholder = '') {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const value = body.value;
      const selected = value.slice(start, end);
      const wrappedInside = isWrapped(selected, before, after);
      const wrappedAround = start >= before.length
        && value.slice(start - before.length, start) === before
        && value.slice(end, end + after.length) === after;
      let rangeStart = start;
      let rangeEnd = end;
      let replacement = selected || placeholder;
      let selectionStart = start;
      let selectionEnd = start + replacement.length;

      if (wrappedInside) {
        replacement = selected.slice(before.length, selected.length - after.length);
        selectionEnd = start + replacement.length;
      } else if (wrappedAround) {
        rangeStart = start - before.length;
        rangeEnd = end + after.length;
        selectionStart = rangeStart;
        selectionEnd = rangeStart + selected.length;
      } else {
        replacement = before + replacement + after;
        selectionEnd = start + replacement.length;
      }

      runEditorEdit(() => {
        body.focus();
        body.setRangeText(replacement, rangeStart, rangeEnd, 'end');
        body.setSelectionRange(selectionStart, selectionEnd);
      });
    }
    function prefixLines(prefix, numbered = false) {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const lineStart = body.value.lastIndexOf('\n', Math.max(0, start - 1)) + 1;
      const nextLine = body.value.indexOf('\n', end);
      const lineEnd = nextLine === -1 ? body.value.length : nextLine;
      const selected = body.value.slice(lineStart, lineEnd);
      const lines = selected.split('\n').map((line, index) => `${numbered ? `${index + 1}. ` : prefix}${line}`);
      runEditorEdit(() => {
        body.focus();
        body.setRangeText(lines.join('\n'), lineStart, lineEnd, 'select');
      });
    }
    function insertTemplate(template) {
      const body = $('body');
      runEditorEdit(() => {
        body.focus();
        body.setRangeText(template, body.selectionStart, body.selectionEnd, 'end');
      });
    }
    function applyToolbarAction(action) {
      if (action === 'bold') toggleWrap('**', '**', '加粗文字');
      if (action === 'italic') toggleWrap('*', '*', '斜体文字');
      if (action === 'h1') prefixLines('# ');
      if (action === 'h2') prefixLines('## ');
      if (action === 'h3') prefixLines('### ');
      if (action === 'bullet') prefixLines('- ');
      if (action === 'numbered') prefixLines('', true);
      if (action === 'quote') prefixLines('> ');
      if (action === 'code') toggleWrap('`', '`', '代码');
      if (action === 'link') replaceSelection('[', '](https://example.com)', '链接文字');
      if (action === 'image') insertTemplate('![图片描述](图片地址)');
      if (action === 'table') insertTemplate('| 项目 | 说明 |\n| --- | --- |\n| 内容 | 示例 |');
    }

    async function switchCollection(collectionId) {
      if (collectionId === state.collectionId) return;
      if (!(await ensureEditorSaved())) return;
      state.collectionId = collectionId;
      state.selectedPath = '';
      state.dirty = false;
      state.filters = {};
      closePopovers();
      const config = activeCollection();
      $('library-title').textContent = config.label;
      $('editor-title').textContent = `编辑${config.label}`;
      $('editor-description').textContent = config.description;
      renderTabs();
      renderMetadata();
      await createNew();
      try { await loadEntries(); } catch (error) { setStatus(error.message, 'error'); }
    }

    $('search').oninput = renderEntries;
    $('filter-toggle').onclick = () => togglePopover('filter-popover', 'filter-toggle');
    $('sort-toggle').onclick = () => togglePopover('sort-popover', 'sort-toggle');
     $('clear-filters').onclick = () => { state.filters = {}; renderFilters(); renderEntries(); };
     $('immersive-toggle').onclick = () => setImmersiveMode(!document.body.classList.contains('is-immersive'));
    $('immersive-exit').onclick = () => setImmersiveMode(false);
    immersiveMedia.addEventListener('change', placeImmersiveToggle);
    placeImmersiveToggle();
    document.addEventListener('click', (event) => { if (!event.target.closest('#list-tools-wrap')) closePopovers(); });
    document.addEventListener('click', (event) => { if (!event.target.closest('[data-custom-select]')) closeCustomSelects(); });
    document.addEventListener('click', (event) => { if (!event.target.closest('[data-multiselect]')) closeMultiselectMenus(); });
     document.addEventListener('keydown', (event) => {
       if (event.key !== 'Escape') return;
       if (closeEscapeLayers()) return;
       if (document.body.classList.contains('is-immersive')) {
         event.preventDefault();
         setImmersiveMode(false);
       }
     });
    $('refresh').onclick = () => loadEntries().catch((error) => setStatus(error.message, 'error'));
    $('new-entry').onclick = createNew;
    $('save').onclick = () => { void saveEntry({ force: true }); };
    $('delete').onclick = openDeleteModal;
    $('delete-modal-close').onclick = () => closeDeleteModal();
    $('delete-modal-cancel').onclick = () => closeDeleteModal();
    $('delete-modal-confirm').onclick = () => { void deleteCurrentEntry(); };
    $('delete-modal').onclick = (event) => { if (!deletePromise && (event.target === event.currentTarget || (event.target instanceof Element && event.target.matches('[data-delete-close]')))) closeDeleteModal(); };
    $('body').addEventListener('keydown', handleBodyKeydown);
    $('body').oninput = handleBodyInput;
    function scrollBodyToEdge(edge) {
      const body = $('body');
      body.focus({ preventScroll: true });
      body.scrollTo({ top: edge === 'top' ? 0 : body.scrollHeight, behavior: 'smooth' });
    }
    $('scroll-to-top').onclick = () => scrollBodyToEdge('top');
    $('scroll-to-bottom').onclick = () => scrollBodyToEdge('bottom');
    document.addEventListener('keydown', handleHistoryShortcut);
    window.addEventListener('pagehide', () => { rememberEditorSession(); rememberEditorDraft(); });
    document.querySelectorAll('.editor-tool').forEach((button) => { button.onclick = () => applyToolbarAction(button.dataset.action); });
    $('sync-to-preview').onclick = syncSourceToPreview;
     $('sync-to-source').onclick = syncPreviewToSource;
     setImmersiveMode(readImmersiveSession(), { focus: false, persist: false });
    $('preview').addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const imageLink = target?.closest('a.timeline-image-link');
      if (imageLink && $('preview').contains(imageLink)) {
        event.preventDefault();
        openPreviewLightbox(imageLink, imageLink.href, imageLink.dataset.imageAlt || imageLink.textContent.trim());
        return;
      }
      const image = target?.closest('img');
      if (image && $('preview').contains(image) && !image.closest('a')) {
        event.preventDefault();
        openPreviewLightbox(image, image.currentSrc || image.src, image.alt);
        return;
      }
      const block = findPreviewBlock(event.target);
      if (block) {
        selectedPreviewNode = block;
        if (window.getSelection()?.isCollapsed !== false) selectedPreviewSourceRange = null;
      }
    });
    $('preview').addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const target = event.target instanceof Element ? event.target : null;
      const image = target?.closest('img');
      if (!image || !$('preview').contains(image) || image.closest('a')) return;
      event.preventDefault();
      openPreviewLightbox(image, image.currentSrc || image.src, image.alt);
    });
    $('preview').addEventListener('mouseup', capturePreviewSelection);
    document.addEventListener('selectionchange', capturePreviewSelection);
    renderSortOptions();

    request('collections').then(async (data) => {
      state.collections = data.collections;
      const savedSession = readEditorSession();
      const firstCollection = state.collections.some((item) => item.id === savedSession?.collectionId)
        ? savedSession.collectionId
        : state.collections[0]?.id;
      if (!firstCollection) throw new Error('没有可用的内容解析器');
      await switchCollection(firstCollection);
      const savedDraft = readEditorDraft();
      if (restoreEditorDraft(savedDraft)) {
        restoreEditorPosition(savedDraft);
        return;
      }
      const savedEntry = savedSession?.selectedPath && state.entries.find((entry) => entry.path === savedSession.selectedPath);
      if (savedEntry) {
        await loadEntry(savedEntry.path);
        restoreEditorPosition(savedSession);
      }
    }).catch((error) => setStatus(error.message, 'error'));
  </script>
