---
import 'katex/dist/katex.min.css';

const isDev = import.meta.env.DEV;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{isDev ? <>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <title>开发笔记后台</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { min-width: 320px; background: #edf2f3; }
    body {
      min-width: 320px;
      min-height: 100vh;
      margin: 0;
      background: #edf2f3;
      color: #1e293b;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
    }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    .admin { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 8px; max-width: 1720px; height: 100vh; min-height: 720px; margin: auto; padding: 10px 16px 16px; }
    .topbar, .tabs, .panel { border: 1px solid #dbe5e7; background: rgba(255, 255, 255, .96); box-shadow: 0 5px 18px rgba(15, 63, 70, .06); }
    .topbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 58px; padding: 9px 16px; border-radius: 10px; }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-mark { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 10px; color: #fff; background: #0f766e; font-size: 18px; font-weight: 800; }
    .brand-title { margin: 0; overflow: hidden; color: #0f4c55; font-size: 21px; font-weight: 800; letter-spacing: -.035em; text-overflow: ellipsis; white-space: nowrap; }
    .environment { display: inline-flex; align-items: center; gap: 7px; padding: 6px 10px; border: 1px solid #b7e2dc; border-radius: 7px; color: #0f766e; background: #f0fdfa; font-size: 12px; font-weight: 700; white-space: nowrap; }
    .environment::before { width: 7px; height: 7px; border-radius: 50%; background: #14b8a6; content: ""; }
    .back-link { display: inline-flex; align-items: center; gap: 7px; padding: 8px 12px; border: 1px solid #d5e1e3; border-radius: 8px; color: #334155; background: #fff; font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; }
    .back-link:hover { border-color: #0f766e; color: #0f766e; background: #f0fdfa; }
    .tabs { display: flex; gap: 6px; overflow-x: auto; padding: 6px; border-radius: 10px; }
    .topbar .tabs { flex: 1 1 auto; justify-content: center; min-width: 0; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
    .topbar .tabs .tab { min-height: 34px; padding: 0 13px; }
    .tab { flex: 0 0 auto; min-height: 36px; padding: 0 16px; border: 1px solid transparent; border-radius: 7px; color: #64748b; background: transparent; font-size: 13px; font-weight: 700; }
    .tab:hover { color: #0f766e; background: #f0fdfa; }
    .tab.active { border-color: #9edbd3; color: #0f766e; background: #e7f8f5; }
    .workspace { display: grid; grid-template-columns: minmax(300px, 360px) minmax(0, 1fr); gap: 8px; min-height: 0; }
    .panel { min-width: 0; min-height: 0; border-radius: 10px; }
    .sidebar { display: grid; grid-template-rows: auto auto auto minmax(0, 1fr); padding: 16px 13px 12px; }
    .panel-heading, .editor-heading, .toolbar, .list-tools, .editor-label, .editor-footer, .status-actions { display: flex; align-items: center; }
    .panel-heading, .editor-heading { justify-content: space-between; gap: 12px; }
    h2, h3, p { margin-top: 0; }
    .panel-heading h2, .editor-heading h2 { margin-bottom: 0; color: #153b42; letter-spacing: -.025em; }
    .panel-heading h2 { font-size: 18px; }
    .panel-heading-actions { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .panel-heading-actions .secondary { flex: 0 0 auto; padding: 0 9px; }
    .immersive-exit { display: none; align-items: center; justify-content: center; }
    .entry-count { color: #94a3b8; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .search-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 7px; margin: 14px 0 8px; }
    .search { position: relative; min-width: 0; }
    .search input { width: 100%; min-height: 38px; padding: 0 12px 0 34px; border: 1px solid #d8e4e6; border-radius: 8px; outline: 0; color: #1e293b; background: #fbfefe; }
    .search input:focus, .filter-field select:focus, .field input:focus, .field select:focus, .field textarea:focus, .path-row input:focus { border-color: #36a79b; box-shadow: 0 0 0 3px rgba(20, 184, 166, .12); }
    .search::before { position: absolute; top: 10px; left: 12px; color: #7c9296; content: "⌕"; font-size: 18px; }
    .list-tools-wrap { position: relative; }
    .list-tools { gap: 7px; }
    .list-tools button, .toolbar button, .secondary, .primary, .add-link { min-height: 34px; border: 1px solid #d3e0e2; border-radius: 7px; color: #47636a; background: #fff; font-size: 12px; font-weight: 700; }
    .list-tools button { display: inline-flex; align-items: center; justify-content: center; gap: 5px; min-height: 38px; padding: 0 9px; white-space: nowrap; }
    .list-tools button:hover, .list-tools button[aria-expanded="true"], .list-tools button.has-active { border-color: #8ed2c9; color: #0f766e; background: #f0fdfa; }
    .tool-icon { display: inline-grid; width: 16px; height: 16px; place-items: center; color: #6d8389; font-size: 15px; font-weight: 800; line-height: 1; }
    .tool-icon svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.4; }
    .list-tools button:hover .tool-icon, .list-tools button[aria-expanded="true"] .tool-icon, .list-tools button.has-active .tool-icon { color: #0f766e; }
    .filter-badge { display: inline-grid; min-width: 18px; height: 18px; padding: 0 4px; place-items: center; border-radius: 999px; color: #fff; background: #c2410c; font-size: 10px; line-height: 1; }
    .popover { position: absolute; z-index: 20; top: calc(100% + 7px); right: 0; left: auto; width: 260px; max-height: min(70vh, 520px); overflow: auto; padding: 12px; border: 1px solid #cfe0e2; border-radius: 9px; background: #fff; box-shadow: 0 14px 32px rgba(15, 63, 70, .16); }
    .popover[hidden] { display: none; }
    #sort-popover { width: 180px; }
    .popover-heading, .popover-footer { display: flex; align-items: center; justify-content: space-between; gap: 9px; }
    .popover-heading { margin-bottom: 10px; }
    .popover-heading strong { color: #25515a; font-size: 12px; }
    .popover-heading span, .popover-empty { color: #8aa0a5; font-size: 10px; }
    .filter-fields { display: grid; grid-template-columns: 1fr; gap: 8px; }
    .filter-field, .field { display: grid; gap: 5px; color: #5b7280; font-size: 11px; font-weight: 700; }
    .filter-field select, .field input, .field select, .field textarea, .path-row input { width: 100%; min-height: 36px; padding: 7px 9px; border: 1px solid #d7e3e5; border-radius: 7px; outline: 0; color: #1e293b; background: #fbfefe; }
    .field textarea { min-height: 84px; resize: vertical; line-height: 1.55; }
    .filter-field select, .field select { padding-right: 6px; }
    .custom-select { position: relative; align-self: start; width: 100%; min-width: 0; }
    .custom-select-native { position: absolute; width: 1px; height: 1px; min-height: 0 !important; padding: 0 !important; border: 0 !important; opacity: 0; pointer-events: none; }
    .custom-select-trigger { display: flex; width: 100%; height: 36px; min-height: 36px; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 9px; border: 1px solid #d7e3e5; border-radius: 7px; color: #1e293b; background: #fbfefe; font-size: 12px; font-weight: 600; text-align: left; }
    .custom-select-trigger:hover { border-color: #36b1a5; color: #0f766e; background: #fff; }
    .custom-select-trigger:disabled { border-color: #dfe8e9; color: #9aaeb2; background: #f4f8f8; cursor: not-allowed; }
    .custom-select-trigger svg { width: 15px; height: 15px; flex: 0 0 auto; color: #6d8389; transition: transform .15s ease, color .15s ease; }
    .custom-select.open .custom-select-trigger { border-color: #36b1a5; box-shadow: inset 0 0 0 1px #36b1a5; }
    .custom-select.open .custom-select-trigger svg { color: #0f766e; transform: rotate(180deg); }
    .custom-select-menu { position: absolute; z-index: 30; top: calc(100% + 5px); right: 0; left: 0; max-height: 220px; overflow-y: auto; padding: 5px; border: 1px solid #cfe0e2; border-radius: 8px; background: #fff; box-shadow: 0 12px 26px rgba(15, 63, 70, .14); }
    .custom-select-menu[hidden] { display: none; }
    .custom-select-option { display: flex; width: 100%; min-height: 32px; align-items: center; padding: 0 8px; border: 0; border-radius: 6px; color: #47636a; background: transparent; font-size: 11px; font-weight: 600; text-align: left; }
    .custom-select-option:hover, .custom-select-option.is-selected { border: 0; color: #0f766e; background: #eaf9f6; }
    .custom-select-option::before { width: 16px; flex: 0 0 16px; color: #0f766e; content: ""; font-size: 13px; font-weight: 800; }
    .custom-select-option.is-selected::before { content: "✓"; }
    .popover-footer { margin-top: 11px; padding-top: 10px; border-top: 1px solid #e7eff0; }
    .popover-footer button { min-height: 29px; padding: 0 9px; border: 1px solid #d3e0e2; border-radius: 6px; color: #587178; background: #fff; font-size: 11px; font-weight: 700; }
    .popover-footer button:hover { border-color: #64b9b0; color: #0f766e; background: #f0fdfa; }
    .sort-options { display: grid; gap: 4px; }
    .sort-option { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 9px; min-height: 32px; padding: 0 9px; border: 1px solid transparent; border-radius: 6px; color: #587178; background: transparent; font-size: 11px; font-weight: 700; text-align: left; }
    .sort-option:hover { background: #f2f8f8; }
    .sort-option.active { border-color: #b7e2dc; color: #0f766e; background: #eaf9f6; }
    .sort-option::after { color: transparent; content: "✓"; }
    .sort-option.active::after { color: #0f766e; }
    .toolbar { gap: 7px; margin-bottom: 9px; }
    .toolbar button { flex: 1; padding: 0 8px; }
    .toolbar button:first-child, .primary { border-color: #0f766e; color: #fff; background: #0f766e; }
    .toolbar button:first-child:hover, .primary:hover { background: #0b5f59; }
    .toolbar button:hover, .secondary:hover, .add-link:hover { border-color: #64b9b0; color: #0f766e; background: #f0fdfa; }
    .entry-list { min-height: 0; overflow: auto; padding-right: 3px; }
    .entry { display: grid; gap: 4px; width: 100%; margin-bottom: 5px; padding: 10px 10px 9px; border: 1px solid transparent; border-radius: 8px; text-align: left; color: #334155; background: transparent; }
    .entry:hover { background: #f2f8f8; }
    .entry.active { border-color: #b7e2dc; background: #e9f8f5; }
    .entry strong { overflow: hidden; color: #21434a; font-size: 12px; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
    .entry small { overflow: hidden; color: #8aa0a5; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
    .entry-meta { display: flex; gap: 6px; overflow: hidden; color: #6f858a; font-size: 10px; white-space: nowrap; }
    .entry-meta span { overflow: hidden; text-overflow: ellipsis; }
    .empty { margin: 18px 4px; color: #94a3b8; font-size: 12px; line-height: 1.7; }
    .main-panel { display: grid; grid-template-rows: auto minmax(0, auto) minmax(0, 1fr); overflow: hidden; }
    .editor-heading { padding: 17px 18px 12px; }
    .editor-heading h2 { font-size: 19px; }
    .editor-heading p { margin: 5px 0 0; color: #789096; font-size: 12px; }
    .status-actions { gap: 10px; }
    .status { color: #789096; font-size: 12px; font-weight: 700; }
    .status.saving { color: #b7791f; }
    .status.saved { color: #0f766e; }
    .status.error { color: #b42318; }
    .delete-button { min-height: 34px; padding: 0 13px; border: 1px solid #efd0d0; border-radius: 7px; color: #b42318; background: #fff; font-size: 12px; font-weight: 700; white-space: nowrap; }
    .delete-button:hover { border-color: #e7a6a6; color: #9f1d1d; background: #fff5f5; }
    .delete-button:disabled { border-color: #e5ebec; color: #aebdc0; background: #f7fafa; }
    .primary, .secondary { padding: 0 13px; }
    .metadata { position: relative; z-index: 2; overflow: visible; padding: 0 18px 12px; }
    .metadata-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; align-items: stretch; }
    .metadata-group { min-width: 0; margin: 0; padding: 13px; border: 1px solid #e3ecee; border-radius: 9px; background: #fbfefe; }
    .metadata-group h3 { margin-bottom: 3px; color: #25515a; font-size: 13px; }
    .metadata-group > p { margin-bottom: 9px; color: #8aa0a5; font-size: 11px; }
    .metadata-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; align-content: start; }
    .metadata-group .path-row { margin-bottom: 10px; }
    .field.wide { grid-column: 1 / -1; }
    .required { color: #d14343; }
    .multiselect-control { position: relative; align-self: start; width: 100%; min-width: 0; }
    .multiselect-trigger { display: flex; width: 100%; height: 36px; min-height: 36px; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 9px; border: 1px solid #d7e3e5; border-radius: 7px; color: #1e293b; background: #fbfefe; font-size: 12px; font-weight: 600; text-align: left; }
    .multiselect-trigger:hover, .multiselect-trigger[aria-expanded="true"] { border-color: #36a79b; color: #0f766e; background: #fff; }
    .multiselect-trigger:focus-visible { outline: 3px solid rgba(20, 184, 166, .14); outline-offset: 1px; }
    .multiselect-label { overflow: hidden; color: #1e293b; text-overflow: ellipsis; white-space: nowrap; }
    .multiselect-label.empty { color: #91a4a8; font-weight: 500; }
    .multiselect-chevron { color: #6d8389; font-size: 14px; line-height: 1; }
    .multiselect-menu { position: absolute; z-index: 12; top: calc(100% + 5px); right: 0; left: 0; max-height: 220px; overflow: auto; padding: 5px; border: 1px solid #cfe0e2; border-radius: 8px; background: #fff; box-shadow: 0 12px 26px rgba(15, 63, 70, .14); }
    .multiselect-menu[hidden] { display: none; }
    .multiselect-option { position: relative; display: flex; width: 100%; min-height: 32px; align-items: center; padding: 0 8px 0 30px; border: 0; border-radius: 6px; color: #47636a; background: transparent; font-size: 11px; font-weight: 600; text-align: left; cursor: pointer; }
    .multiselect-option:hover, .multiselect-option.is-selected { color: #0f766e; background: #eaf9f6; }
    .multiselect-option::before { position: absolute; left: 8px; width: 16px; flex: 0 0 16px; color: #0f766e; content: ""; font-size: 13px; font-weight: 800; line-height: 1; }
    .multiselect-option.is-selected::before { content: "✓"; }
    .multiselect-option > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .multiselect-option input { position: absolute; width: 1px !important; height: 1px !important; min-height: 1px !important; margin: -1px; padding: 0 !important; border: 0 !important; opacity: 0; pointer-events: none; }
    .multiselect-option:focus-within { outline: 2px solid rgba(20, 184, 166, .18); outline-offset: -1px; }
    .links-list { display: grid; gap: 7px; }
    .link-row { display: grid; grid-template-columns: minmax(120px, .75fr) minmax(180px, 1.25fr) auto; gap: 6px; }
    .link-row input { min-height: 34px; padding: 6px 8px; border: 1px solid #d7e3e5; border-radius: 7px; outline: 0; }
    .remove-link { width: 34px; border: 1px solid #efd0d0; border-radius: 7px; color: #b42318; background: #fff; }
    .add-link { margin-top: 7px; padding: 0 10px; }
    .editor-workspace { --editor-content-gap: 24px; --editor-caret-space: 10.2em; position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 0; border: 1px solid #dbe5e7; border-radius: 8px; overflow: hidden; background: #fff; }
    .editor-sync-controls { position: absolute; top: 50%; left: 50%; z-index: 3; display: grid; gap: 3px; transform: translate(-50%, -50%); padding: 4px; border: 1px solid #dbe5e7; border-radius: 999px; background: #fff; box-shadow: 0 5px 14px rgba(15, 63, 70, .13); }
    .editor-sync-button { display: grid; width: 25px; height: 25px; min-width: 25px; place-items: center; padding: 0; border: 0; border-radius: 50%; color: #647b82; background: transparent; }
    .editor-sync-button:hover { color: #0f766e; background: #e7f8f5; }
    .editor-sync-button:focus-visible { outline: 2px solid rgba(20, 184, 166, .24); outline-offset: 1px; }
    .editor-sync-button svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
    .editor-column { display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; min-width: 0; min-height: 0; }
    .editor-column:last-child { grid-template-rows: auto minmax(0, 1fr); }
    .editor-column + .editor-column { border-left: 1px solid #e1eaec; }
    .editor-label { min-height: 42px; justify-content: space-between; gap: 12px; padding: 0 13px; border-bottom: 1px solid #e1eaec; color: #153b42; font-size: 12px; font-weight: 800; }
    .editor-label-title { display: inline-flex; align-items: center; gap: 7px; min-width: 0; }
    .editor-label-title svg { width: 15px; height: 15px; flex: 0 0 auto; color: #47636a; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
    .editor-label > span { color: #8aa0a5; font-size: 11px; font-weight: 600; }
    .editor-toolbar { display: flex; align-items: center; gap: 2px; min-height: 37px; padding: 4px 8px; overflow-x: auto; border-bottom: 1px solid #e1eaec; background: #fbfefe; }
    .editor-tool { display: inline-grid; min-width: 27px; height: 27px; flex: 0 0 auto; place-items: center; padding: 0 5px; border: 0; border-radius: 5px; color: #52656b; background: transparent; font-size: 13px; font-weight: 700; }
    .editor-tool:hover { color: #0f766e; background: #e7f8f5; }
    .editor-tool:focus-visible { outline: 2px solid rgba(20, 184, 166, .22); outline-offset: 1px; }
    .editor-tool-divider { width: 1px; height: 20px; flex: 0 0 auto; margin: 0 5px; background: #e1eaec; }
    .editor-pane { position: relative; display: block; min-width: 0; min-height: 0; overflow: hidden; background: #fff; }
    #body { display: block; width: 100%; max-width: 100%; min-width: 0; min-height: 0; height: 100%; padding: 15px var(--editor-content-gap) calc(15px + var(--editor-caret-space)) 15px; border: 0; border-radius: 0; outline: 0; resize: none; overflow-x: hidden; overflow-y: auto; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; color: #243b42; background: #fff; font: 12px/1.7 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    #body:focus { box-shadow: inset 0 0 0 2px rgba(20, 184, 166, .12); }
    .editor-jump-controls { position: absolute; right: 12px; bottom: 12px; z-index: 2; display: grid; gap: 6px; }
    .editor-jump-button { display: grid; width: 30px; height: 30px; place-items: center; padding: 0; border: 1px solid rgba(20, 100, 105, .24); border-radius: 50%; color: rgba(15, 118, 110, .82); background: rgba(255, 255, 255, .78); box-shadow: 0 3px 10px rgba(15, 63, 70, .12); opacity: .58; transition: opacity .15s, color .15s, background-color .15s, transform .15s; }
    .editor-jump-button:hover, .editor-jump-button:focus-visible { color: #0f766e; background: rgba(231, 248, 245, .94); opacity: .96; }
    .editor-jump-button:focus-visible { outline: 2px solid rgba(20, 184, 166, .24); outline-offset: 2px; }
    .editor-jump-button:active { transform: scale(.94); }
    .editor-jump-button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
    .editor-footer { justify-content: space-between; gap: 8px; min-height: 32px; padding: 0 12px; border-top: 1px solid #e1eaec; color: #91a4a8; font-size: 10px; }
    .preview { min-height: 0; overflow: auto; padding: 15px var(--editor-content-gap) calc(15px + var(--editor-caret-space)) 15px; color: #334155; background: #fff; font-size: 13px; line-height: 1.75; transition: opacity .15s; }
    .preview.is-loading { opacity: .62; }
    .preview h1, .preview h2, .preview h3 { color: #21434a; line-height: 1.35; }
    .preview h1 { font-size: 22px; }
    .preview h2 { margin-top: 1.4em; font-size: 18px; }
    .preview h3 { margin-top: 1.2em; font-size: 15px; }
    .preview ul, .preview ol { margin: .4rem 0; padding-left: 1.3rem; }
    .preview blockquote { margin: .6rem 0; padding: .5rem .9rem; border-left: 3px solid #14b8a6; background: #e7f8f5; color: #0f766e; font-size: .85rem; }
    .preview ol { list-style-type: decimal; }
    .preview ol ol { list-style-type: lower-alpha; }
    .preview ol ol ol { list-style-type: lower-roman; }
    .preview ol ol ol ol { list-style-type: decimal; }
    .preview img { max-width: 100%; height: auto; cursor: zoom-in; }
    .preview img:focus-visible, .preview .timeline-image-link:focus-visible { outline: 3px solid rgba(20, 184, 166, .22); outline-offset: 3px; }
    .preview .timeline-image-link { cursor: zoom-in; }
    .preview-lightbox { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 3.5rem 1rem 1rem; background: rgba(0, 0, 0, .82); cursor: zoom-out; }
    .preview-lightbox-content { position: relative; display: flex; align-items: center; justify-content: center; max-width: 92vw; max-height: 92vh; }
    .preview-lightbox img { max-width: 90vw; max-height: 90vh; width: auto; height: auto; border-radius: 8px; box-shadow: 0 8px 40px rgba(0, 0, 0, .4); cursor: default; }
