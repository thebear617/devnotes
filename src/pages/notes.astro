---
import Layout from '../layouts/Layout.astro';
import NoteWall from '../components/NoteWall.astro';
import { getCollection } from 'astro:content';
import { getBoardNav } from '../data/board-nav.js';

const entries = await getCollection('debug');
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
const boards = getBoardNav(base);
const wallEntries = entries.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  updated: entry.data.updated,
  category: entry.data.category,
  subcategory: entry.data.subcategory,
  href: `${base}notes/${entry.data.slug}/`,
}));
---

<Layout>
  <NoteWall entries={wallEntries} title="Debug 库" boardId="notes" boards={boards} placeholder="开发调试、问题排查与工具经验会自动出现在这里。" />
</Layout>
