---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const blogs = await getCollection('blog');
blogs.sort((a, b) => new Date(b.data.updated || b.data.date).getTime() - new Date(a.data.updated || b.data.date).getTime());

const PRIMARY_TAGS = ['编程', '科研', '随想'];
const SECONDARY_TAGS = ['综述', '实践', '入门', '方法', '会议', '随笔'];
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
  <main class="app-shell">
    <h2 class="view-title">博客</h2>
    <p class="view-sub">编程 · 科研 · 随想</p>

    <div class="list-search" id="blogSearch">
      <span class="list-search-icon">🔍</span>
      <input
        type="search"
        id="blogSearchInput"
        class="list-search-input"
        placeholder="搜索标题、描述或标签"
        autocomplete="off"
        aria-label="搜索博客"
      />
      <button class="list-search-clear" id="blogSearchClear" aria-label="清除搜索">✕</button>
    </div>

    {blogs.length > 0 && (
      <div class="filter-bar" id="filterBar">
        <div class="filter-row">
          <span class="filter-label">分类</span>
          <div class="filter-tags" data-filter="primary">
            {PRIMARY_TAGS.map(t => <button class="filter-tag">{t}</button>)}
          </div>
        </div>
        <div class="filter-row">
          <span class="filter-label">标签</span>
          <div class="filter-tags" data-filter="tags">
            {SECONDARY_TAGS.map(t => <button class="filter-tag">{t}</button>)}
            <button class="filter-clear" id="filterClear">清除筛选</button>
          </div>
        </div>
      </div>
    )}

    {blogs.length > 0 ? (
      <div class="blog-list" id="blogList">
        {blogs.map(blog => (
          <a
            href={`${base}blog/${blog.slug}/`}
            class="blog-card"
            data-tags={blog.data.tags.join(',')}
            data-primary={blog.data.tags.filter(t => PRIMARY_TAGS.includes(t)).join(',')}
            data-secondary={blog.data.secondaryTag || ''}
            data-title={blog.data.title}
            data-desc={blog.data.description || ''}
          >
            <div class="blog-card-title">{blog.data.title}</div>
            {blog.data.description && <p class="blog-card-desc">{blog.data.description}</p>}
            <div class="blog-card-meta">{blog.data.date}</div>
            {blog.data.tags.length > 0 && (
              <div class="blog-card-tags">
                {blog.data.tags.map(t => <span class="blog-tag">{t}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>
    ) : (
      <section class="empty-state">还没有博客文章</section>
    )}

    <section class="empty-state" id="emptyState" style="display:none">没有匹配的博客</section>
  </main>
</Layout>

<script>
  let filters = {};
  let searchTerm = '';

  document.querySelectorAll('.filter-bar .filter-tag').forEach(tag => {
    tag.addEventListener('click', () => {
      const row = tag.closest('.filter-row');
      const filterKey = row.querySelector('.filter-tags').dataset.filter;
      const on = tag.classList.toggle('on');
      if (on) {
        row.querySelectorAll('.filter-tag').forEach(t => { if (t !== tag) t.classList.remove('on'); });
        filters[filterKey] = tag.textContent;
      } else {
        delete filters[filterKey];
      }
      applyFilters();
    });
  });

  const filterClear = document.getElementById('filterClear');
  filterClear?.addEventListener('click', () => {
    document.querySelectorAll('.filter-bar .filter-tag.on').forEach(t => t.classList.remove('on'));
    filters = {};
    applyFilters();
  });

  const searchInput = document.getElementById('blogSearchInput');
  const searchClear = document.getElementById('blogSearchClear');
  searchInput.addEventListener('input', () => {
    searchTerm = searchInput.value.trim().toLowerCase();
    searchClear.style.display = searchTerm ? '' : 'none';
    applyFilters();
  });
  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    searchClear.style.display = 'none';
    searchInput.focus();
    applyFilters();
  });

  function applyFilters() {
    const visible = [];
    document.querySelectorAll('#blogList .blog-card').forEach(card => {
      let show = true;
      if (filters.primary && !card.dataset.primary.split(',').includes(filters.primary)) show = false;
      if (show && filters.tags && card.dataset.secondary !== filters.tags) show = false;
      if (show && searchTerm) {
        const haystack = (card.dataset.title + ' ' + card.dataset.desc + ' ' + card.dataset.tags).toLowerCase();
        show = haystack.includes(searchTerm);
      }
      card.style.display = show ? '' : 'none';
      if (show) visible.push(card);
    });
    document.getElementById('emptyState').style.display = visible.length ? 'none' : '';
  }
</script>